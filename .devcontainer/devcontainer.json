// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/docker-in-docker
{
	"name": "NullAwayAnnotatorBaseline",

	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:2": {
			"version": "latest",
			"enableNonRootDocker": "true",
			"moby": "true"
		}
    },

    "build": {
        // Use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
        "dockerfile": "Dockerfile"
    },

	"containerEnv": {
    	"OPENAI_KEY": "${localEnv:OPENAI_KEY}"
	},

    "mounts": [
		"source=${env:HOME}/.ssh,target=/home/vscode/.ssh,type=bind",
		"source=${env:HOME}/.config/mini-swe-agent,target=/home/vscode/.config/mini-swe-agent,type=bind",
        "source=${env:HOME}/Documents/projects/nullrepair/nullrepair_log_files,target=/home/vscode/Desktop,type=bind",
        "source=${env:HOME}/Documents/projects/nullrepair/nullness-benchmarks,target=/home/vscode/nullness-benchmarks,type=bind"
    ],
	"workspaceMount": "source=${localWorkspaceFolder},target=/home/vscode/NullAwayAnnotatorBaseline,type=bind",
	"workspaceFolder": "/home/vscode/NullAwayAnnotatorBaseline",

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Set owner of /usr/lib/android-sdk to vscode user. Then build the NullAwayAnnotatorBaseline project and set up the Python environment for minisweagent
	"postCreateCommand": "sudo chown -R $(id -u):$(id -g) /usr/lib/android-sdk && ./gradlew :annotator-core:spotlessApply && ./gradlew build -x test && ./gradlew publishToMavenLocal && python3 -m venv .venv && . .venv/bin/activate && pip install -e mini-swe-agent-for-nullaway-codefix && docker build -t joos/minisweagent_for_nullrepair mini-swe-agent-for-nullaway-codefix/src/minisweagent/environments",

	// Configure tool-specific properties.
	// "customizations": {},

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	"remoteUser": "vscode",

	// Set the container name
	"runArgs": ["--name", "${localEnv:USER}_null_away_annotator_baseline"]
}