      node.left = node.parent = node.right = null;
      node.height = 1;

      // Skip a leaf if necessary.
      if (leavesToSkip > 0 && (size & 1) == 0) {
        size++;
        leavesToSkip--;
        leavesSkipped++;
      }

      node.parent = stack;
      stack = node; // Stack push.
      size++;

      // Skip a leaf if necessary.
      if (leavesToSkip > 0 && (size & 1) == 0) {
        size++;
        leavesToSkip--;
        leavesSkipped++;
      }

      /*
       * Combine 3 nodes into subtrees whenever the size is one less than a
       * multiple of 4. For example we combine the nodes A, B, C into a
       * 3-element tree with B as the root.
       *
       * Combine two subtrees and a spare single value whenever the size is one
       * less than a multiple of 8. For example at 8 we may combine subtrees
       * (A B C) and (E F G) with D as the root to form ((A B C) D (E F G)).
       *
       * Just as we combine single nodes when size nears a multiple of 4, and
       * 3-element trees when size nears a multiple of 8, we combine subtrees of
       * size (N-1) whenever the total size is 2N-1 whenever N is a power of 2.
       */
      for (int scale = 4; (size & scale - 1) == scale - 1; scale *= 2) {
        if (leavesSkipped == 0) {
          // Pop right, center and left, then make center the top of the stack.
          Node<K, V> right = stack;
          if (right == null) {
            break;
          }
          Node<K, V> center = right.parent;
          if (center == null) {
            break;
          }
          Node<K, V> left = Nullability.castToNonnull(center).parent;
          if (left == null) {
            break;
          }
          Node<K, V> leftParent = left.parent;
          Nullability.castToNonnull(center).parent = leftParent;
          if (leftParent != null) {
            if (leftParent.left == left) {
              leftParent.left = Nullability.castToNonnull(center);
            } else {
              leftParent.right = Nullability.castToNonnull(center);
            }
          }
          stack = Nullability.castToNonnull(center);
          // Construct a tree.
          Nullability.castToNonnull(center).left = left;
          Nullability.castToNonnull(center).right = right;
          Nullability.castToNonnull(center).height = right.height + 1;
          left.parent = Nullability.castToNonnull(center);
          right.parent = Nullability.castToNonnull(center);
        } else if (leavesSkipped == 1) {
          // Pop right and center, then make center the top of the stack.
          Node<K, V> right = stack;
          if (right == null) {
            break;
          }
          Node<K, V> center = right.parent;
          if (center == null) {
            break;
          }
          stack = Nullability.castToNonnull(center);
          // Construct a tree with no left child.
          Nullability.castToNonnull(center).right = right;
          Nullability.castToNonnull(center).height = right.height + 1;
          right.parent = Nullability.castToNonnull(center);
          leavesSkipped = 0;
        } else if (leavesSkipped == 2) {
          leavesSkipped = 0;
        }
      }
}
