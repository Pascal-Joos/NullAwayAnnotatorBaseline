   209    private void incrementStats(Target target) {
   210      if (target == Target.FullFetch) {
   211        DynamicCounter.increment(
   212            "eureka.throttler.fullFetch", "id", 
StatusUtil.getStatus().name());
   213      } else if (target == Target.DeltaFetch) {
   214        DynamicCounter.increment(
   215            "eureka.throttler.deltaFetch", "id", 
StatusUtil.getStatus().name());
   216      }
   217    }
