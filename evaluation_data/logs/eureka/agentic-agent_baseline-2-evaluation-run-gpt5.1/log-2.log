   146  
   147    private static Target getTarget(ServletRequest request) {
   148      Target target = Target.Other;
   149      if (request instanceof HttpServletRequest) {
   150        HttpServletRequest httpRequest = (HttpServletRequest) request;
   151        String pathInfo = httpRequest.getRequestURI();
   152  
   153        if ("GET".equals(httpRequest.getMethod()) && pathInfo != null) {
   154          Matcher matcher = TARGET_RE.matcher(pathInfo);
   155          if (matcher.matches()) {
   156            if (matcher.groupCount() == 0
   157                || matcher.group(1) == null
   158                || "/".equals(matcher.group(1))) {
   159              target = Target.FullFetch;
   160            } else if ("/delta".equals(matcher.group(1))) {
   161              target = Target.DeltaFetch;
   162            } else {
   163              target = Target.Application;
   164            }
   165          }
   166        }
   167        if (target == Target.Other) {
   168          logger.debug("URL path {} not matched by rate limiting filter", 
pathInfo);
   169        }
   170      }
   171      return target;
   172    }
   173  
   174    private boolean isRateLimited(HttpServletRequest request, Target 
target) {
   175      if (isPrivileged(request)) {
   176        logger.debug("Privileged {} request", target);
   177        return false;
   178      }
   179      if (isOverloaded(target)) {
   180        logger.debug("Overloaded {} request; discarding it", target);
   181        return true;
   182      }
   183      return false;
   184    }
   185  
   186    private boolean isPrivileged(HttpServletRequest request) {
   187      Set<String> privilegedClients = DEFAULT_PRIVILEGED_CLIENTS;
   188      if (serverConfig != null && 
serverConfig.isRateLimiterThrottleStandardClients()) {
   189        privilegedClients = new HashSet<>(DEFAULT_PRIVILEGED_CLIENTS);
   190        
privilegedClients.remove(EurekaClientIdentity.DEFAULT_CLIENT_NAME);
   191      }
   192      String clientName = 
request.getHeader(AbstractEurekaIdentity.AUTH_NAME_HEADER_KEY);
   193      return privilegedClients.contains(clientName)
   194          || PeerEurekaNodes.isPeerEurekaNode(clientName, serverConfig);
   195    }
   196  
   197    private boolean isOverloaded(Target target) {
   198      int maxInWindow = serverConfig.getRateLimiterBurstSize();
   199      int fetchWindowSize = 
serverConfig.getRateLimiterRegistryFetchAverageRate();
   200      boolean overloaded = !registryFetchRateLimiter.acquire(maxInWindow, 
fetchWindowSize);
   201  
   202      if (target == Target.FullFetch) {
   203        int fullFetchWindowSize = 
serverConfig.getRateLimiterFullFetchAverageRate();
   204        overloaded |= !registryFullFetchRateLimiter.acquire(maxInWindow, 
fullFetchWindowSize);
   205      }
   206      return overloaded;
   207    }
