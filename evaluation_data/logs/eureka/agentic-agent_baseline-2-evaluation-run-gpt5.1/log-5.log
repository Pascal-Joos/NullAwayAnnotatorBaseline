  private void executeChange(Change change, HostedZone hostedZone) {
    logger.info("Execute change {} ", change);
    ChangeResourceRecordSetsRequest changeResourceRecordSetsRequest =
    ChangeResourceRecordSetsRequest changeResourceRecordSetsRequest =
        new ChangeResourceRecordSetsRequest();
