class com.netflix.eureka.aws.Route53Binder {
@Override
  @PostConstruct
  public void start() {
    try {
      doBind();
      timer.schedule(
          new TimerTask() {
            @Override
            public void run() {
              try {
                doBind();
              } catch (Throwable e) {
                logger.error("Could not bind to Route53", e);
              }
            }
          },
          serverConfig.getRoute53BindingRetryIntervalMs(),
          serverConfig.getRoute53BindingRetryIntervalMs());
    } catch (InterruptedException e) {
      throw new RuntimeException(e);
    }
}@Override
  @PreDestroy
  public void shutdown() {
    timer.cancel();

    for (String domain : getDeclaredDomains()) {
      try {
        unbindFromDomain(domain);
      } catch (InterruptedException e) {
        throw new RuntimeException(e);
      }
    }

    amazonRoute53Client.shutdown();
}
}
```


