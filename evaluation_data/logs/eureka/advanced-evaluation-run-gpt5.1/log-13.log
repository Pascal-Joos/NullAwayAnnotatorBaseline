      if (gMap == null) {
        final ConcurrentHashMap<String, Lease<InstanceInfo>> gNewMap =
            new ConcurrentHashMap<String, Lease<InstanceInfo>>();
        gMap = registry.putIfAbsent(registrant.getAppName(), gNewMap);
        if (gMap == null) {
          gMap = gNewMap;
        }
