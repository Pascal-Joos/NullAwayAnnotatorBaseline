    if (leaseToRenew == null) {
      RENEW_NOT_FOUND.increment(isReplication);
      logger.warn("DS: Registry: lease doesn't exist, registering resource: {} - {}", appName, id);
      return false;
    } else {
      InstanceInfo instanceInfo = leaseToRenew.getHolder();
