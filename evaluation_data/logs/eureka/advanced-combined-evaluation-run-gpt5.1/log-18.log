        new TimedSupervisorTask(
            "RemoteRegionFetch_" + regionName,
            scheduler,
            remoteRegionFetchExecutor,
            serverConfig.getRemoteRegionRegistryFetchInterval(),
            TimeUnit.SECONDS,
            5, // exponential backoff bound
            remoteRegionFetchTask),
        serverConfig.getRemoteRegionRegistryFetchInterval(),
        TimeUnit.SECONDS);

