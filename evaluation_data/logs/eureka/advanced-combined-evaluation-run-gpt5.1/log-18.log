        new ThreadPoolExecutor(
            1,
            serverConfig.getRemoteRegionFetchThreadPoolSize(),
            0,
            TimeUnit.SECONDS,
            new SynchronousQueue<Runnable>()); // use direct handoff

    scheduler =
        Executors.newScheduledThreadPool(
            1,
