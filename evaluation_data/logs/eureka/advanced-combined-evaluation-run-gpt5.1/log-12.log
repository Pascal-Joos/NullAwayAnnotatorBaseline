      replicationClient.sendHeartBeat(appName, id, info, overriddenStatus);
      return;
    }
    ReplicationTask replicationTask =
        new InstanceReplicationTask(targetHost, Action.Heartbeat, info, overriddenStatus, false) {
          @Override
