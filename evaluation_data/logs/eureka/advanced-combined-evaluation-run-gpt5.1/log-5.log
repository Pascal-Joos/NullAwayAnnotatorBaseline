          if (createResourceRecordSet(rrs)) {
            logger.info("Bind {} to {}", registrationHostname, Nullability.castToNonnull(rrs.getResourceRecordSet()).getName());
            return;
          }
        }
  
        logger.warn("Unable to find free domain in {}", domains);
