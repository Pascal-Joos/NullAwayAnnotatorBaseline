              ? coll1.getCollisionBox().getMaxY()
              : m1.getBoundingBox().getMaxY();
      final double m2MaxY =
          coll2 != null && coll2.getCollisionBox() != null
              ? coll2.getCollisionBox().getMaxY()
              : m2.getBoundingBox().getMaxY();
      return Double.valueOf(m1MaxY).compareTo(m2MaxY);
}
