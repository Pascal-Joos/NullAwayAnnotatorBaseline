              key -> {
                // don't take a screenshot if a modifier is active
                if (key.getModifiers() != 0) {
                  return;
                }

                window().getRenderComponent().takeScreenshot();
              });
    }

    Runtime.getRuntime().addShutdownHook(new Thread(Game::terminate, "Shutdown"));

