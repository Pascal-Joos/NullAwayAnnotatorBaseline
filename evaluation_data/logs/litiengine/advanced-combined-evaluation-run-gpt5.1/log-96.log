        .onKeyTyped(
            KeyEvent.VK_UP,
            e -> {
              if (this.isSuspended()
                  || !this.isVisible()
                  || !this.isArrowKeyNavigation()
                  || !this.getChosenElementComponent().isHovered()) {
                return;
