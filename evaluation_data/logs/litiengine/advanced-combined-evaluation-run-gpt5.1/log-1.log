class de.gurkenlabs.litiengine.GameMetrics {
@Override
    public void render(final Graphics2D g) {
      this.updateMetrics();
  
      if (!Game.config().client().showGameMetrics()) {
        return;
      }
  
      this.currentOffsetY = 0;
  
      g.setColor(this.renderColor);
  
      // render client metrics
