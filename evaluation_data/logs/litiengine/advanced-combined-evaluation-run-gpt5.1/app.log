    return ++maxMapID;
}private void addAmbientLight() {
      if (this.getMap() != null) {
        final Color ambientColor =
            this.getMap().getColorValue(MapProperty.AMBIENTCOLOR, AmbientLight.DEFAULT_COLOR);
        this.ambientLight = new AmbientLight(this, ambientColor);
