    final AffineTransform otx = g.getTransform();
    this.rendering = true;

    try {
      g.scale(Game.world().camera().getRenderScale(), Game.world().camera().getRenderScale());
      if (this.getMap() != null && this.getMap().getBackgroundColor() != null) {
