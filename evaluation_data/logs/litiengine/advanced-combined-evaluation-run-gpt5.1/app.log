  public Spritesheet load(final SpritesheetResource info) {
    Spritesheet sprite = null;
    if (info.getImage() == null || info.getImage().isEmpty()) {
      log.log(
          Level.SEVERE,
          "Sprite {0} could not be loaded because no image is defined.",
          new Object[] {info.getName()});
      return null;
    } else {
