}public MapObjectLayer(MapObjectLayer original) {
    super(original);
    int mapId = Game.world().environment().getNextMapId();
    for (IMapObject obj : original.getMapObjects()) {
      this.addMapObject(new MapObject((MapObject) obj, mapId));
      mapId++;
