        Optional<IMapObject> opt =
            layer.getMapObjects().stream()
                .filter(
                    mapObject ->
                        mapObject.getType() != null
                            && !mapObject.getType().isEmpty()
                            && mapObject.getId() == mapId)
                .findFirst();
        if (opt.isPresent()) {
          return !this.load(opt.get()).isEmpty();
        }
      }
  
      return false;
}
