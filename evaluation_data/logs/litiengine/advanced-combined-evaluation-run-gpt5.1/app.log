            this.defaultgamepadId = -1;
            final Gamepad newGamePad = current();
            if (newGamePad != null) {
              this.defaultgamepadId = newGamePad.getId();
              this.hookupToGamepad(newGamePad);
            }
          }
        });

    updateGamepads();
}
}
