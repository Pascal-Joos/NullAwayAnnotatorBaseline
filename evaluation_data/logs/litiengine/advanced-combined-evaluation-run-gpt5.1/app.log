            : MathUtilities.clamp(focus.getX(), minX, maxX);
    double y =
        maxY < minY
            ? maxY + this.valign.getValue(minY - maxY - mapSize.getHeight())
            : MathUtilities.clamp(focus.getY(), minY, maxY);

    return new Point2D.Double(x, y);
}
