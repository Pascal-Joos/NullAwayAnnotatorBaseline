                  this.setSelection(
                      this.getHorizontalLowerBound() + col % this.getNumberOfShownColumns(),
                      this.getVerticalLowerBound()
                          + this.getListEntry(col).indexOf(comp) % this.getNumberOfShownRows());
                  this.refresh();
                });
