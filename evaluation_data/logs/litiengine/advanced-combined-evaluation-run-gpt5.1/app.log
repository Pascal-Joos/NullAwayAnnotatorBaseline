          collisionBox.getCenterY() + this.getOffsetY());
    } else if (type == DIMENSION_CENTER) {
      return this.getEntity().getCenter();
    } else {
      return new Point2D.Double(
          this.getEntity().getX() + this.getOffsetX(), this.getEntity().getY() + this.getOffsetY());
    }
}
}
