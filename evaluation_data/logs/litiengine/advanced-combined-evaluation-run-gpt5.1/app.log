      Rectangle2D newCollisionBox = entity.getCollisionBox(newPosition);
      if (newCollisionBox == null) {
        return false;
      }
      final Line2D line =
          new Line2D.Double(
              collisionBox.getCenterX(),
              collisionBox.getCenterY(),
              newCollisionBox.getCenterX(),
