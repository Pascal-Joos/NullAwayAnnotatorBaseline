        this.stop();
        return;
      }

      pi.currentSegment(startCoordinates);
      pi.next();
    }

    if (pi.isDone()) {
      this.stop();
      return;
    }

    pi.currentSegment(coordinates);

    final double distance =
        GeometricUtilities.distance(
            this.entity.getCollisionBox().getCenterX(),
            this.entity.getCollisionBox().getCenterY(),
            coordinates[0],
            coordinates[1]);
