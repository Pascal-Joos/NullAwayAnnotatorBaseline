            verticalSlider
                .getSliderComponent()
                .setLocation(verticalSlider.getRelativeSliderPosition());
            this.refresh();
          });
    }
    final HorizontalSlider horizontalSlider = this.getHorizontalSlider();
    if (horizontalSlider != null) {
