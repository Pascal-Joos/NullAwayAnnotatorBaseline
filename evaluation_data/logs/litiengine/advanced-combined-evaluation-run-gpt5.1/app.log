          info.getImageFormat() == null ? "" : info.getImageFormat().toFileExtension();
      sprite =
          load(
              Codec.decodeImage(info.getImage()),
              info.getName() + fileExtension,
              info.getWidth(),
              info.getHeight());
    }

    if (info.getKeyframes() != null && info.getKeyframes().length > 0) {
