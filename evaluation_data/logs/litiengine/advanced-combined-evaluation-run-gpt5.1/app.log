      }
      if (this.getHorizontalSlider() != null) {
        this.getHorizontalSlider().setCurrentValue(this.getHorizontalLowerBound());
      }
      this.getComponents().add(this.getHorizontalSlider());
    }

    if (maxNbOfRows > 0) {
      if (this.isSliderInside()) {
        if (this.getHorizontalSlider() != null) {
