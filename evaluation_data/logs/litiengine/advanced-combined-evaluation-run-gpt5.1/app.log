@Override
    public float[] getTweenValues(TweenType tweenType) {
      switch (tweenType) {
        case POSITION_X:
          return new float[] {(float) this.getX()};
        case POSITION_Y:
          return new float[] {(float) this.getY()};
        case POSITION_XY:
