        if (GeometricUtilities.intersects(otherBox, rect)) {
          Rectangle2D intersection = otherBox.createIntersection(rect);
          if (result != null) {
            result =
                new Intersection(
                    intersection.createUnion(result),
                    ArrayUtilities.append(result.involvedEntities, otherEntity));
          } else {
            result = new Intersection(intersection, otherEntity);
          }
        }
      }
  
      return result;
}
}
