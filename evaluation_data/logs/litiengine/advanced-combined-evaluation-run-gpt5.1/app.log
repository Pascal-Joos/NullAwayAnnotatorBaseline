      this.getTags().add(tag);
    }
    if (this.getEnvironment() != null) {
      this.getEnvironment()
          .getEntitiesByTag()
          .computeIfAbsent(tag, t -> new CopyOnWriteArrayList<>())
          .add(this);
    }
}@Override
