    final float deltaY =
        (float)
            ((this.getEntity().getHeight() / 2.0)
                + this.bubble.getHeight()
                + this.getAppearance().getPadding()
                + 1);

    final float startX = (float) (entityCenter.getX() - deltaX);
    final float startY = (float) (entityCenter.getY() - deltaY);
