            ShapeRenderer.renderOutlineTransformed(
                g,
                new Rectangle2D.Double(
                    renderLocation.getX(), renderLocation.getY(), img.getWidth(), img.getWidth()),
                animationController.getAffineTransform(),
                0.25f);
          }
        }
      }
