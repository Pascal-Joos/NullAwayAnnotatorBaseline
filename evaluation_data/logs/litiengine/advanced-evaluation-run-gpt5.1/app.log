        } else if (Nullability.castToNonnull(Game.window()).getResolution().getHeight() - mouseLocation.getY()
            < this.getScrollPadding()) {
          deltaY += scrollSpeed;
        }
  
        x += deltaX;
        y += deltaY;
  
