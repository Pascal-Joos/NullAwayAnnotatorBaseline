          Rectangle2D collisionBox = coll.getCollisionBox();
          if (collisionBox == null) {
            continue;
          }
  
          if (collisionBox.intersects(this.getCollisionBox())) {
            collEntities.add(coll);
          }
        }
  
        return collEntities;
}public boolean canTrigger(ICollisionEntity entity) {
        return entity.canCollideWith(this)
            && GeometricUtilities.intersects(this.getCollisionBox(), Nullability.castToNonnull(entity.getCollisionBox()));
}
