                this.setVerticalLowerBound(sliderValue.intValue());
                this.getVerticalSlider()
                    .getSliderComponent()
                    .setLocation(this.getVerticalSlider().getRelativeSliderPosition());
                this.refresh();
              });
    }
    if (this.getHorizontalSlider() != null) {
