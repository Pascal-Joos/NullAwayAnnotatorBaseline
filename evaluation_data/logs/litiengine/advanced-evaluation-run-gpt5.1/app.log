class de.gurkenlabs.litiengine.gui.NumberAdjuster {
public NumberAdjuster(
      final double x,
      final double y,
      final double width,
      final double height,
      final double lowerBound,
      final double upperBound,
      final double startValue,
      final double stepSize) {
