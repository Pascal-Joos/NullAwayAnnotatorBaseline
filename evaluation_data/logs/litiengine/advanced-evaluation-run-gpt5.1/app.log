    float x = image.getWidth() / 2.0f;
    float y = image.getHeight() / 2.0f;

    this.drawShadow(
        graphics, image.getWidth(), image.getHeight(), x + this.offsetX, y + this.offsetY);

    ImageRenderer.render(graphics, image, x, y);
    graphics.dispose();
    return buffer;
  }
