      final Color outlineColor,
      final boolean antiAliasing) {
    float stroke =
        (float)
            MathUtilities.clamp(
                (g.getFont().getSize2D() * 1 / 5f)
                    * Math.log(Game.world().camera().getRenderScale()),
                1,
                100);
    renderWithOutline(g, text, x, y, outlineColor, stroke, antiAliasing);
}
}
