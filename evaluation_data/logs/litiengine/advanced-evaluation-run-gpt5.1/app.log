    for (Collision type : Collision.values()) {
      if (type == Collision.NONE) {
        continue;
      }

      this.collisionBoxes.get(type).clear();
      this.collisionBoxes
          .get(type)
          .addAll(
              this.collisionEntities.get(type).stream()
                  .map(ICollisionEntity::getCollisionBox)
                  .collect(Collectors.toList()));
