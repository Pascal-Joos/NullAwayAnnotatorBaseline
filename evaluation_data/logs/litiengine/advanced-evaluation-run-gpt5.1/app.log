@Override
    public int compare(final IEntity m1, final IEntity m2) {
      ICollisionEntity coll1 = null;
      ICollisionEntity coll2 = null;
      if (m1 instanceof ICollisionEntity) {
        coll1 = (ICollisionEntity) m1;
      }
  
      if (m2 instanceof ICollisionEntity) {
        coll2 = (ICollisionEntity) m2;
      }
  
      final Rectangle2D coll1Box = coll1 != null ? coll1.getCollisionBox() : null;
      final Rectangle2D coll2Box = coll2 != null ? coll2.getCollisionBox() : null;
  
      final double m1MaxY =
          coll1Box != null ? coll1Box.getMaxY() : m1.getBoundingBox().getMaxY();
      final double m2MaxY =
          coll2Box != null ? coll2Box.getMaxY() : m2.getBoundingBox().getMaxY();
      return Double.valueOf(m1MaxY).compareTo(m2MaxY);
}
