      if (mouseX >= this.minSliderX && mouseX <= this.maxSliderX) {
        final double relativeMouseX = mouseX - this.minSliderX;
        final double percentage = relativeMouseX / (this.maxSliderX - this.minSliderX);
        this.setCurrentValue(
