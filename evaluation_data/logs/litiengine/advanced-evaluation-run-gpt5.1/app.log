public static void render(
      final Graphics2D g,
      final IMap map,
      final Rectangle2D viewport,
      Environment env,
      RenderType... renderTypes) {
    renderLayers(g, map, map, viewport, env, renderTypes, 1f);
}public static void render(
      Graphics2D g, IMap map, Rectangle2D viewport, RenderType... renderTypes) {
