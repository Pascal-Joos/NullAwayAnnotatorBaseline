          if (mouse != null) {
            final Point2D locationWithOffset =
                new Point2D.Double(
                    mouse.getLocation().getX() + this.getOffsetX(),
                    mouse.getLocation().getY() + this.getOffsetY());
            ImageRenderer.renderTransformed(g, this.getImage(), locationWithOffset, this.getTransform());
