        final int grabX = (int) (screenLocation.x + screenCenterX);
        final int grabY = (int) (screenLocation.y + screenCenterY);
  
        this.robot.mouseMove(grabX, grabY);
  
        diffX = e.getXOnScreen() - (double) grabX;
        diffY = e.getYOnScreen() - (double) grabY;
