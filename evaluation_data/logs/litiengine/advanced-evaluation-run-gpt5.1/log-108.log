                .setLocation(this.getHorizontalSlider().getRelativeSliderPosition());
          }
        });
    if (this.getVerticalSlider() != null) {
      this.getVerticalSlider()
          .onChange(
              sliderValue -> {
                this.setVerticalLowerBound(sliderValue.intValue());
                this.getVerticalSlider()
                    .getSliderComponent()
