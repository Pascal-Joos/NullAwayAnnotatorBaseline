    if (bg != null) {
      ImageRenderer.render(g, bg, this.getLocation());
    }

    final BufferedImage img = this.getImage();
    if (img != null) {
      ImageRenderer.render(g, img, this.getImageLocation(img));
    }
    super.render(g);
}
