      if (this.getEncoding().equals(Encoding.BASE64)) {
        for (TileChunk chunk : this.chunks) {
          List<Tile> chunkTiles = parseBase64Data(chunk.getValue(), this.compression);
          this.addTiles(tileArr, chunk, chunkTiles);
