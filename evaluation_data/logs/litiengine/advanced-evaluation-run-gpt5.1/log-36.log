        return null;
      }
  
      final ICamera cam = Game.world().camera();
  
      return cam.getMapLocation(
          new Point2D.Double(
              this.getLocation().getX() / cam.getRenderScale(),
              this.getLocation().getY() / cam.getRenderScale()));
