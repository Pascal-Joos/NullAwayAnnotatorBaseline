      // old text was displayed long enough
      if (this.lastTextDisplay != 0
          && Game.time().since(this.lastTextDisplay) > this.currentTextDisplayTime) {
        this.currentText = null;
        this.lastTextDisplay = 0;
        return;
      }
  
