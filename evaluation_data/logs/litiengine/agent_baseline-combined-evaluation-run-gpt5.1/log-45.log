package de.gurkenlabs.litiengine.environment.tilemap.xml;

import de.gurkenlabs.litiengine.environment.tilemap.ICustomProperty;
import java.net.MalformedURLException;
import java.net.URISyntaxException;
import java.net.URL;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;
import javax.xml.bind.Marshaller;
import javax.xml.bind.Unmarshaller;
import javax.xml.bind.annotation.XmlAttribute;
import javax.xml.bind.annotation.XmlElement;
import javax.xml.bind.annotation.adapters.XmlAdapter;

public class CustomPropertyAdapter
    extends XmlAdapter<CustomPropertyAdapter.PropertyList, Map<String, 
ICustomProperty>> {

  public static class Property implements Comparable<Property>, ICustomProperty 
{
    @XmlAttribute private String name;

    @XmlAttribute private PropertyType type;

    @XmlAttribute private String value;

    private URL location;

    public Property() {}

    public Property(String name, PropertyType type, String value) {
      this.value = value;
      this.name = name;
      this.type = type == null || !PropertyType.isValid(type) ? 
PropertyType.STRING : type;
    }

    @SuppressWarnings("unused")
    private void afterUnmarshal(Unmarshaller u, Object parent) throws 
MalformedURLException {
      if (this.type == null) {
        this.type = PropertyType.STRING;
      }
      if (this.type.equals(PropertyType.FILE)) {
        this.location = u.getAdapter(URLAdapter.class).unmarshal(this.value);
      }
    }

    @SuppressWarnings("unused")
    private void beforeMarshal(Marshaller m) throws URISyntaxException {
      if (this.type != null && this.type.equals(PropertyType.STRING)) {
        this.type = null;
      }
      if (this.location != null) {
        this.value = m.getAdapter(URLAdapter.class).marshal(this.location);
      }
    }

    @Override
    public int compareTo(Property o) {
      if (o == null) {
        return 1;
      }

      if (o.name == null && this.name == null) {
        return 0;
      }

      if (this.name == null) {
        return -1;
      }

      return this.name.compareTo(o.name);
    }

    @Override
    public String getName() {
      return this.name;
    }

    @Override
    public PropertyType getType() {
      return this.type;
    }

    @Override
    public String getValue() {
      return this.value;
    }

    @Override
    public URL getFileValue() {
      return this.location;
    }
  }

  public static class PropertyList {
    @XmlElement(name = "property")
    private List<Property> properties;

    public PropertyList() {
      this.properties = new ArrayList<>();
    }

    public PropertyList(List<Property> properties) {
      this.properties = properties;
    }

    public List<Property> getProperties() {
      return this.properties;
    }
  }

  @Override
  public Map<String, ICustomProperty> unmarshal(PropertyList v) {
    Map<String, ICustomProperty> map = new HashMap<>();
    if (v == null || v.getProperties() == null) {
      return map;
    }

    for (Property prop : v.getProperties()) {
      if (prop != null && prop.getName() != null) {
        map.put(prop.getName(), prop);
      }
    }

    return map;
  }

  @Override
  public PropertyList marshal(Map<String, ICustomProperty> v) {
    List<Property> list = new ArrayList<>();
    if (v != null) {
      for (ICustomProperty prop : v.values()) {
        if (prop != null && prop.getName() != null) {
          list.add(new Property(prop.getName(), prop.getType(), 
prop.getValue()));
        }
      }
    }

    return new PropertyList(list);
  }
}
