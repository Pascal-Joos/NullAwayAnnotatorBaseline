  private final Collection<ILightSource> lightSources = new ArrayList<>();
  private final Collection<ISpawnpoint> spawnPoints = new ArrayList<>();
  private final Collection<ISoundSource> soundSources = new ArrayList<>();
  private final Collection<MapArea> mapAreas = new ArrayList<>();
  private final Collection<IGravityForce> gravityForces = new ArrayList<>();
  private final Map<Integer, Collection<IEntity>> layerEntities = new 
