@XmlRootElement(name = "tileset")
@XmlAccessorType(XmlAccessType.FIELD)
public class Tileset extends CustomPropertyProvider implements ITileset {
  private static final Logger log = Logger.getLogger(Tileset.class.getName());
  public static final String FILE_EXTENSION = "tsx";

  @XmlAttribute private int firstgid;

  @Nullable @XmlElement private MapImage image;

  @Nullable @XmlAttribute private Integer margin;

  @Nullable @XmlAttribute private String name;

  @Nullable @XmlAttribute private Integer tilewidth;

  @Nullable @XmlAttribute private Integer tileheight;

  @Nullable
  @XmlElement(name = "tileoffset")
  private TileOffset tileoffset;

  @Nullable @XmlAttribute private Integer tilecount;

  @Nullable @XmlAttribute private Integer columns;

  @Nullable @XmlAttribute private Integer spacing;

  @Nullable @XmlAttribute private String source;

  @Nullable
  @XmlElementWrapper(name = "terraintypes")
  @XmlElement(name = "terrain")
  private List<Terrain> terrainTypes = null;

  @Nullable
  @XmlElement(name = "tile")
  private List<TilesetEntry> tiles = null;

  @Nullable @XmlTransient private List<TilesetEntry> allTiles;

  @Nullable @XmlTransient protected Tileset sourceTileset;

  @Nullable private transient Spritesheet spriteSheet;

  public Tileset() {
    Resources.images().addClearedListener(() -> this.spriteSheet = null);
  }

  public Tileset(Tileset source) {
    this.source = source.getName() + "." + FILE_EXTENSION;
    this.sourceTileset = source;
    this.firstgid = 1;
  }

  @Override
  public Map<String, ICustomProperty> getProperties() {
    return this.sourceTileset != null ? this.sourceTileset.getProperties() : 
super.getProperties();
  }

  @Override
  public int getFirstGridId() {
    return this.firstgid;
  }

  @Nullable
  @Override
  public IMapImage getImage() {
    return this.sourceTileset != null ? this.sourceTileset.getImage() : 
this.image;
  }

  /**
   * Gets the margin.
   *
   * @return the margin
   */
  @Override
  public int getMargin() {
    if (this.sourceTileset != null) {
      return this.sourceTileset.getMargin();
    }

    if (this.margin == null) {
      return 0;
    }

    return this.margin;
  }

  @Nullable
  @Override
  public String getName() {
    return this.sourceTileset != null ? this.sourceTileset.getName() : 
this.name;
  }

  @Override
  public void setName(String name) {
    this.name = name;
  }

  /**
   * Gets the spacing.
   *
   * @return the spacing
   */
  @Override
  public int getSpacing() {
    if (this.sourceTileset != null) {
      return this.sourceTileset.getSpacing();
    }

    if (this.spacing == null) {
      return 0;
    }

    return this.spacing;
  }

  @Nullable
  @Override
  @XmlTransient
  public Spritesheet getSpritesheet() {
    if (this.spriteSheet == null && this.getImage() != null) {
      this.spriteSheet = 
Resources.spritesheets().get(this.getImage().getSource());
      if (this.spriteSheet == null) {
        this.spriteSheet = Resources.spritesheets().load(this);
        if (this.spriteSheet == null) {
          return null;
        }
      }
    }

    return this.spriteSheet;
  }

  @Override
  public Dimension getTileDimension() {
    return this.sourceTileset != null
        ? this.sourceTileset.getTileDimension()
        : new Dimension(this.getTileWidth(), this.getTileHeight());
  }

  /**
   * Gets the tile height.
   *
   * @return the tile height
   */
  @Override
  public int getTileHeight() {
    return this.sourceTileset != null ? this.sourceTileset.getTileHeight() : 
this.tileheight;
  }

  /**
   * Gets the tile width.
   *
   * @return the tile width
   */
  @Override
  public int getTileWidth() {
    return this.sourceTileset != null ? this.sourceTileset.getTileWidth() : 
this.tilewidth;
  }

  @Override
  public List<ITerrain> getTerrainTypes() {
    if (this.sourceTileset != null) {
      return this.sourceTileset.getTerrainTypes();
    }

    List<ITerrain> types = new ArrayList<>();
    if (this.terrainTypes == null) {
      return types;
    }

    for (int i = 0; i < this.terrainTypes.size(); i++) {
      types.add(i, this.terrainTypes.get(i));
    }

    return types;
  }

  @Override
  public ITerrain[] getTerrain(int tileId) {
    if (this.sourceTileset != null) {
      return this.sourceTileset.getTerrain(tileId);
    }

    ITerrain[] terrains = new ITerrain[4];
    if (!this.containsTile(tileId)) {
      return terrains;
    }

    if (this.allTiles == null) {
      return terrains;
    }

    TilesetEntry tile = this.allTiles.get(tileId);
    if (tile == null) {
      return terrains;
    }

    int[] tileTerrains = tile.getTerrainIds();
    for (int i = 0; i < 4; i++) {
      if (tileTerrains[i] < 0 || tileTerrains[i] >= 
this.getTerrainTypes().size()) {
        continue;
      }

      ITerrain terrain = this.getTerrainTypes().get(tileTerrains[i]);
      if (terrain == null) {
        continue;
      }

      terrains[i] = terrain;
    }

    return terrains;
  }

  @Override
  public int getColumns() {
    return this.sourceTileset != null ? this.sourceTileset.getColumns() : 
this.columns;
  }

  @Nullable
  @Override
  public ITileOffset getTileOffset() {
    return this.sourceTileset != null ? this.sourceTileset.getTileOffset() : 
this.tileoffset;
  }

  @Override
  public int getTileCount() {
    if (this.sourceTileset != null) {
      return this.sourceTileset.getTileCount();
    }

    if (this.tilecount == null) {
      return 0;
    }

    return this.tilecount;
  }

  @Override
  public int getTileWidthSpacing() {
    return this.getTileWidth() + this.getSpacing();
  }

  @Override
  public int getTileHeightSpacing() {
    return this.getTileHeight() + this.getSpacing();
  }

  @Override
  public int getMarginX() {
    return this.getMargin();
  }

  @Override
  public int getMarginY() {
    return this.getMargin();
  }

  @Override
  public int getFirstTileId() {
    return this.getFirstGridId();
  }

  @Override
  public int getLastTileId() {
    return this.getFirstGridId() + this.getTileCount() - 1;
  }

  @Override
  public boolean containsTile(int tileId) {
    return tileId >= this.getFirstTileId() && tileId <= this.getLastTileId();
  }

  @Override
  public ITile getTile(int tileId) {
    if (this.sourceTileset != null) {
      return this.sourceTileset.getTile(tileId);
    }

    if (!this.containsTile(tileId)) {
      return null;
    }

    if (this.allTiles == null) {
      this.allTiles = new ArrayList<>();
      if (this.tiles != null) {
        this.allTiles.addAll(this.tiles);
      }
    }

    int index = tileId - this.getFirstTileId();
    while (this.allTiles.size() <= index) {
      this.allTiles.add(null);
    }

    TilesetEntry tile = this.allTiles.get(index);
    if (tile == null) {
      tile = new TilesetEntry();
      tile.setId(index);
      this.allTiles.set(index, tile);
    }

    return tile;
  }

  @Override
  public ITilesetEntry getTilesetEntry(int tileId) {
    return (ITilesetEntry) this.getTile(tileId);
  }

  @Override
  public Iterator<ITile> iterator() {
    return new Iterator<ITile>() {
      private int currentId = getFirstTileId();

      @Override
      public boolean hasNext() {
        return this.currentId <= getLastTileId();
      }

      @Override
      public ITile next() {
        return getTile(this.currentId++);
      }
    };
  }

  @Override
  public ListIterator<ITile> listIterator() {
    return new ListIterator<ITile>() {
      private int currentId = getFirstTileId();

      @Override
      public boolean hasNext() {
        return this.currentId <= getLastTileId();
      }

      @Override
      public ITile next() {
        return getTile(this.currentId++);
      }

      @Override
      public boolean hasPrevious() {
        return this.currentId > getFirstTileId();
      }

      @Override
      public ITile previous() {
        return getTile(--this.currentId);
      }

      @Override
      public int nextIndex() {
        return this.currentId - getFirstTileId();
      }

      @Override
      public int previousIndex() {
        return this.currentId - getFirstTileId() - 1;
      }

      @Override
      public void remove() {
        throw new UnsupportedOperationException();
      }

      @Override
      public void set(ITile e) {
        throw new UnsupportedOperationException();
      }

      @Override
      public void add(ITile e) {
        throw new UnsupportedOperationException();
      }
    };
  }

  public void afterUnmarshal(Unmarshaller u, Object parent) {
    if (this.source != null && !this.source.isEmpty()) {
      URL baseUrl = XmlUtilities.getSystemIdAsUrl(u);
      if (baseUrl != null) {
        try {
          URL sourceUrl = new URL(baseUrl, this.source);
          this.sourceTileset = Resources.tilesets().get(sourceUrl);
        } catch (MalformedURLException e) {
          log.log(Level.SEVERE, e.getMessage(), e);
        }
      }
    }
  }

  public void beforeMarshal(Marshaller m) {
    if (this.sourceTileset != null) {
      this.source = FileUtilities.getFileName(this.sourceTileset.getName()) + 
"." + FILE_EXTENSION;
    }
  }
