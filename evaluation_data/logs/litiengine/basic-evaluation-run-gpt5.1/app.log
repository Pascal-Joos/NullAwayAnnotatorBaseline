      final List<ICollisionEntity> entities = this.collisionEntities.get(type);
      if (entities == null) {
        continue;
      }
      this.collisionBoxes
          .get(type)
          .addAll(
              entities.stream()
                  .map(ICollisionEntity::getCollisionBox)
                  .collect(Collectors.toList()));
    }
  }
