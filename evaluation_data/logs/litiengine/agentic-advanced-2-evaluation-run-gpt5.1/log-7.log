            this.entity.getCollisionBox().getCenterX(),
            this.entity.getCollisionBox().getCenterY(),
            coordinates[0],
            coordinates[1]);
    final float pixelsPerTick = this.entity.getTickVelocity();
    Game.physics()
        .move(
            this.entity,
            (float) angle,
            (float) (distance < pixelsPerTick ? distance : pixelsPerTick));
