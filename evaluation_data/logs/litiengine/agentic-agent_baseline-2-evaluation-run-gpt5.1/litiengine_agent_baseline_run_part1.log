    if (info == null || info.customMapObjectType().isEmpty()) {
      log.log(
          Level.WARNING,
          "Cannot register the custom entity type [{0}]: 
EntityInfo.customMapObjectType must be specified.\nAdd an EntityInfo annotation 
to the class and provide the required information or use the 
registerCustomEntityType overload and provide the type explicitly.",
          entityType.getName());
