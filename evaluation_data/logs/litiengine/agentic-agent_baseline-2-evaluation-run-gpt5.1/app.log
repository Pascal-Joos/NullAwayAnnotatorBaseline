this.isFlippedVertically();
    this.gid =
        gidBitmask
            & ~(FLIPPED_HORIZONTALLY_FLAG | FLIPPED_VERTICALLY_FLAG | 
FLIPPED_DIAGONALLY_FLAG);
  }

