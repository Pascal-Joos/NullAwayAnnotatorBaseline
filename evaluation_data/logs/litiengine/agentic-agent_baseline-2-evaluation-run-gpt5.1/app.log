  @XmlTransient private int offsetY;

  @XmlTransient private int minChunkOffsetXMap;

  @XmlTransient private int minChunkOffsetYMap;

  /** Instantiates a new {@code TileData} instance. */
  public TileData() {
    // keep for serialization
  }

  public TileData(
