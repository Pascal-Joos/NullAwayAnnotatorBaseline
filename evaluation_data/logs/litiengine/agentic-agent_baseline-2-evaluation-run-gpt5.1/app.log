  @Nullable
  public ImageComponent getListEntry(final int column, final int row) {
    if (column < 0
        || row < 0
        || column >= this.listEntries.size()
        || row >= this.listEntries.get(column).size()) {
      return null;
    }
    return this.listEntries.get(column).get(row);
  }

