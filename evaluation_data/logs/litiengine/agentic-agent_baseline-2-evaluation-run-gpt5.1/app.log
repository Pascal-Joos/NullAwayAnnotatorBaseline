    10  /** A {@code SoundPlayback} implementation for the playback of sound 
effects. */
    11  public class SFXPlayback extends SoundPlayback {
    12    private Sound sound;
    13    @Nullable private FloatControl panControl;
    14    private Supplier<Point2D> source;
    15    private int range;
    16    private float volumeModifier;
    17    private VolumeControl volume;
    18    private boolean loop;
    19  
    20    SFXPlayback(Sound sound, Supplier<Point2D> source, boolean loop, int 
range, float volumeModifier)
    21        throws LineUnavailableException {
    22      super(sound.getFormat());
    23      this.loop = loop;
    24      this.sound = sound;
    25      this.panControl =
    26          this.line.isControlSupported(FloatControl.Type.PAN)
    27              ? (FloatControl) this.line.getControl(FloatControl.Type.PAN)
    28              : null;
    29      this.source = source;
    30      this.range = range;
    31      this.volumeModifier = volumeModifier;
    32      this.volume = this.createVolumeControl();
    33    }
    34  
    35    @Override
    36    public void run() {
    37      do {
    38        if (this.play(this.sound)) {
    39          return;
    40        }
    41      } while (this.loop);
    42      this.finish();
    43    }
    44  
    45    void updateLocation(Point2D listenerLocation) {
    46      Point2D location = source.get();
    47      if (location != null) {
    48        double dx = location.getX() - listenerLocation.getX();
    49        double dy = location.getY() - listenerLocation.getY();
    50        double dist = Math.sqrt(dx * dx + dy * dy);
    51        if (this.panControl != null) {
    52          this.panControl.setValue(dist > 0 ? (float) (dx / dist) : 0f);
    53        }
    54        this.volume.set(
    55            Game.config().sound().getSoundVolume()
    56                * this.volumeModifier
    57                * (float) Math.max(1.0 - dist / this.range, 0.0));
    58      } else {
    59        this.volume.set(Game.config().sound().getSoundVolume() * 
this.volumeModifier);
    60      }
    61    }
    62  
    63    @Override
    64    protected void play() {
    65      this.updateLocation(Game.audio().getListenerLocation());
    66      super.play();
    67      Game.audio().addSound(this);
    68    }
    69  }
