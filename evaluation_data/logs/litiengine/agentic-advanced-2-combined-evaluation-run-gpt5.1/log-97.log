@Override
    public void update() {
      super.update();
      // can only walk if no forces are active
      if (!this.isMovementAllowed() || !this.getActiveForces().isEmpty()) {
        this.navigator.stop();
        return;
      }
  
      IMouse mouse = Input.mouse();
      this.navigating = mouse != null && mouse.isRightButtonPressed();
