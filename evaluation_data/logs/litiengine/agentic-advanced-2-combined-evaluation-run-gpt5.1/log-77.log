    this.setText(text);
    this.flickerDelay = 100;
    Input.keyboard().onKeyTyped(this::handleTypedKey);
    this.onClicked(
        e -> {
          if (!this.isSelected()) {
            this.toggleSelection();
          }
        });

    Input.mouse()
        .onClicked(
            e -> {
              if (!this.getBoundingBox().contains(Input.mouse().getLocation())) {
                this.setSelected(false);
              }
