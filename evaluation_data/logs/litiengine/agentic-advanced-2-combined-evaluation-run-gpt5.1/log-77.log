      double borderHeight = this.selectedComponent.getHeight() + 2;

      if (this.isEntireRowSelected()) {
        borderWidth = this.getWidth() + 2;
      }
      if (this.getVerticalSlider() != null
          && this.getVerticalSlider().isVisible()
          && this.isSliderInside()) {
