    Game.audio().update();

    ((Keyboard) Input.keyboard()).update();
    ((Mouse) Input.mouse()).update();

    if (Game.config().input().isGamepadSupport()) {
      for (IUpdateable gamepad : Input.gamepads().getAll()) {
        gamepad.update();
      }
    }
}
}
