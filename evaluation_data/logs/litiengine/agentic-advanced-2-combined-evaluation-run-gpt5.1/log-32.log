    }

    if (this.getMap() != null) {
      Game.physics()
          .setBounds(
              new Rectangle2D.Double(
                  0,
                  0,
                  this.getMap().getSizeInPixels().getWidth(),
                  this.getMap().getSizeInPixels().getHeight()));
