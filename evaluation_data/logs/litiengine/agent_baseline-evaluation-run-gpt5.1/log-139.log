    20    SFXPlayback(Sound sound, Supplier<Point2D> source, boolean loop, int 
range, float volumeModifier)
    21        throws LineUnavailableException {
    22      super(sound.getFormat());
    23      this.loop = loop;
    24      this.sound = sound;
    25      this.panControl =
    26          this.line.isControlSupported(FloatControl.Type.PAN)
    27              ? (FloatControl) this.line.getControl(FloatControl.Type.PAN)
    28              : null;
    29      this.source = source;
