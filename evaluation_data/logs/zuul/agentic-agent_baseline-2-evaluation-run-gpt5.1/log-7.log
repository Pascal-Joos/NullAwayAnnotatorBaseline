    90          Set<Server> oldSet = new HashSet<>(oldList);
    91          Set<Server> newSet = new HashSet<>(newList);
    92          final List<DiscoveryResult> discoveryResults = 
Sets.difference(oldSet, newSet).stream()
    93                  .map(server -> new 
