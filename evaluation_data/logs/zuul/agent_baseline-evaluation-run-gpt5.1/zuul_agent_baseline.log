    24  import com.netflix.loadbalancer.DynamicServerListLoadBalancer;
    25  import com.netflix.loadbalancer.Server;
    26  import com.netflix.niws.loadbalancer.DiscoveryEnabledServer;
    27  import com.netflix.zuul.resolver.Resolver;
    28  import com.netflix.zuul.resolver.ResolverListener;
    29  import java.util.HashSet;
    30  import java.util.List;
    31  import java.util.Set;
    32  import java.util.stream.Collectors;
    33  import javax.annotation.Nullable;
    34  
    35  /**
    36   * @author Argha C
    37   * @since 2/25/21
    38   *
    39   * Implements a resolver, wrapping a ribbon load-balancer.
    40   */
    41  public class DynamicServerResolver implements Resolver<DiscoveryResult> 
{
    42  
    43      private final DynamicServerListLoadBalancer<?> loadBalancer;
    44      ResolverListener<DiscoveryResult> listener;
    45  
    46      public DynamicServerResolver(IClientConfig clientConfig, 
ResolverListener<DiscoveryResult> listener) {
    47          this.loadBalancer = createLoadBalancer(clientConfig);
    48          this.loadBalancer.addServerListChangeListener(this::onUpdate);
    49          this.listener = listener;
    50      }
    51  
    52      @Override
    53      public DiscoveryResult resolve( Object key) {
    54          final Server server = loadBalancer.chooseServer(key);
    55          return server!= null ? new 
DiscoveryResult((DiscoveryEnabledServer) server, 
loadBalancer.getLoadBalancerStats()) : DiscoveryResult.EMPTY;
    56      }
    57  
    58      @Override
    59      public boolean hasServers() {
    60          return !loadBalancer.getReachableServers().isEmpty();
    61      }
    62  
    63      @Override
    64      public void shutdown() {
    65          loadBalancer.shutdown();
    66      }
    67  
    68      private DynamicServerListLoadBalancer<?> 
createLoadBalancer(IClientConfig clientConfig) {
    69          //TODO(argha-c): Revisit this style of LB initialization post 
modularization. Ideally the LB should be pluggable.
    70  
    71          // Use a hard coded string for the LB default name to avoid a 
dependency on Ribbon classes.
    72          String loadBalancerClassName =
    73                  clientConfig.get(NFLoadBalancerClassName, 
"com.netflix.loadbalancer.ZoneAwareLoadBalancer");
    74  
    75          DynamicServerListLoadBalancer<?> lb;
    76          try {
    77              Class<?> clazz = Class.forName(loadBalancerClassName);
    78              lb = 
clazz.asSubclass(DynamicServerListLoadBalancer.class).getConstructor().newInstan
ce();
    79              lb.initWithNiwsConfig(clientConfig);
    80          } catch (Exception e) {
    81              Throwables.throwIfUnchecked(e);
    82              throw new IllegalStateException("Could not instantiate 
LoadBalancer " + loadBalancerClassName, e);
    83          }
    84  
    85          return lb;
    86      }
    87  
    88      @VisibleForTesting
    89      void onUpdate(List<Server> oldList, List<Server> newList) {
    90          Set<Server> oldSet = new HashSet<>(oldList);
    91          Set<Server> newSet = new HashSet<>(newList);
    92          final List<DiscoveryResult> discoveryResults = 
Sets.difference(oldSet, newSet).stream()
    93                  .map(server -> new 
DiscoveryResult((DiscoveryEnabledServer) server, 
loadBalancer.getLoadBalancerStats()))
    94                  .collect(Collectors.toList());
    95          listener.onChange(discoveryResults);
    96      }
    97  }
