    if (zuulCtx.debugRouting()) {
      Debug.addRoutingDebug(
          zuulCtx,
          "Running Filter failed "
              + filter.filterName()
              + " type:"
              + filter.filterType()
              + " order:"
              + filter.filterOrder()
              + " "
              + t.getMessage());
    }
}
}
