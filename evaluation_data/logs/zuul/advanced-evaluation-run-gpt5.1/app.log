                : "unknown";
        spectatorRegistry
            .counter(
                "server.ssl.handshake",
                "success",
                String.valueOf(sslHandshakeCompletionEvent.isSuccess()),
                "protocol",
                String.valueOf(proto),
                "ciphersuite",
