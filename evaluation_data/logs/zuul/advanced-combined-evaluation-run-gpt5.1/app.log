public final List<NamedSocketAddress> getListeningAddresses() {
    if (serverGroup == null) {
      throw new IllegalStateException("Server has not been started");
    }
    return Collections.unmodifiableList(new ArrayList<>(addressesToChannels.keySet()));
}

