                    + sslEvent
                    + ", client_ip = "
                    + clientIP
                    + ", channel_info = "
                    + ChannelUtils.channelInfoForLogging(ctx.channel())
                    + ", error = "
                    + cause;
            if (cause instanceof ClosedChannelException) {
              logger.debug(msg);
            } else {
              logger.debug(msg, cause);
            }
            incrementCounters(sslEvent, null);
