    62    public Duration computeReadTimeout(HttpRequestMessage request, int 
attemptNum) {
    63      IClientConfig clientConfig = getRequestClientConfig(request);
    64      Long originTimeout = getOriginReadTimeout();
    65      Long requestTimeout = getRequestReadTimeout(clientConfig);
    66  
    67      long computedTimeout;
    68      if (originTimeout == null && requestTimeout == null) {
    69        computedTimeout = MAX_OUTBOUND_READ_TIMEOUT_MS.get();
    70      } else if (originTimeout == null || requestTimeout == null) {
    71        computedTimeout = originTimeout == null ? requestTimeout : 
originTimeout;
    72      } else {
    73        // return the stricter (i.e. lower) of the two timeouts
    74        computedTimeout = Math.min(originTimeout, requestTimeout);
    75      }
    76  
    77      // enforce max timeout upperbound
    78      return Duration.ofMillis(Math.min(computedTimeout, 
MAX_OUTBOUND_READ_TIMEOUT_MS.get()));
