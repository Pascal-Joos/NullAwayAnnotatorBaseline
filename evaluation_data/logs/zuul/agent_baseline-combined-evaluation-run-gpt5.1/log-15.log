public class SslHandshakeInfoHandler extends ChannelInboundHandlerAdapter {

  public static final AttributeKey<SslHandshakeInfo> ATTR_SSL_INFO =
      AttributeKey.newInstance("_ssl_handshake_info");
  private static final Logger logger = 
LoggerFactory.getLogger(SslHandshakeInfoHandler.class);

  private static final Registry NOOP_REGISTRY = new NoopRegistry();

  private final Registry spectatorRegistry;
  private final boolean isSSlFromIntermediary;

  public SslHandshakeInfoHandler(Registry spectatorRegistry, boolean 
isSSlFromIntermediary) {
    this.spectatorRegistry = checkNotNull(spectatorRegistry);
    this.isSSlFromIntermediary = isSSlFromIntermediary;
  }

  @VisibleForTesting
  SslHandshakeInfoHandler() {
    this(NOOP_REGISTRY, false);
  }

  @Override
  public void userEventTriggered(ChannelHandlerContext ctx, Object evt) throws 
Exception {
    if (evt instanceof SslHandshakeCompletionEvent) {
      try {
        SslHandshakeCompletionEvent sslEvent = (SslHandshakeCompletionEvent) 
evt;
        if (sslEvent.isSuccess()) {

          CurrentPassport.fromChannel(ctx.channel())
              .add(PassportState.SERVER_CH_SSL_HANDSHAKE_COMPLETE);

          SslHandler sslhandler = 
ctx.channel().pipeline().get(SslHandler.class);
          SSLSession session = sslhandler.engine().getSession();

          ClientAuth clientAuth = whichClientAuthEnum(sslhandler);

          Certificate serverCert = null;
          X509Certificate peerCert = null;

          if ((clientAuth == ClientAuth.REQUIRE || clientAuth == 
ClientAuth.OPTIONAL)
              && session.getPeerCertificates() != null
              && session.getPeerCertificates().length > 0) {
            peerCert = (X509Certificate) session.getPeerCertificates()[0];
          }
          if (session.getLocalCertificates() != null && 
session.getLocalCertificates().length > 0) {
            serverCert = session.getLocalCertificates()[0];
          }

          SslHandshakeInfo info =
              new SslHandshakeInfo(
                  isSSlFromIntermediary,
                  session.getProtocol(),
                  session.getCipherSuite(),
                  clientAuth,
                  serverCert,
                  peerCert);
          ctx.channel().attr(ATTR_SSL_INFO).set(info);

          // Metrics.
          incrementCounters(sslEvent, info);

          // Log the client and server certs.
          if (logger.isDebugEnabled()) {
            logger.debug(
                "SSL Handshake successful. {}",
                ChannelUtils.channelInfoForLogging(ctx.channel(), session));
          }
        } else {
          CurrentPassport.fromChannel(ctx.channel())
              .add(PassportState.SERVER_CH_SSL_HANDSHAKE_FAILED);
          logger.debug(
              "SSL Handshake failed. {}",
              ChannelUtils.channelInfoForLogging(ctx.channel(), 
sslEvent.cause()));
        }
      } catch (Throwable e) {
        logger.error(
            "Error while processing SSL Handshake event. {}",
            ChannelUtils.channelInfoForLogging(ctx.channel(), e));
      }
    } else if (evt instanceof SniCompletionEvent) {
      SniCompletionEvent sniEvent = (SniCompletionEvent) evt;
      if (sniEvent.isSuccess()) {
        CurrentPassport.fromChannel(ctx.channel())
            .add(PassportState.SERVER_CH_SSL_SNI_COMPLETED);
      } else {
        CurrentPassport.fromChannel(ctx.channel())
            .add(PassportState.SERVER_CH_SSL_SNI_FAILED);
      }
    } else if (evt instanceof SslCloseCompletionEvent) {
      SslCloseCompletionEvent closeEvent = (SslCloseCompletionEvent) evt;
      if (closeEvent.isSuccess()) {
        CurrentPassport.fromChannel(ctx.channel())
            .add(PassportState.SERVER_CH_SSL_CLOSE_COMPLETED);
      } else {
        CurrentPassport.fromChannel(ctx.channel())
            .add(PassportState.SERVER_CH_SSL_CLOSE_FAILED);
      }
    }

    super.userEventTriggered(ctx, evt);
  }

  private void incrementCounters(SslHandshakeCompletionEvent sslEvent, 
SslHandshakeInfo info) {
    // TODO(carl-mastrangelo): remove this method and use the 
SslHandshakeInfoHandler in zuul-netty
    // instead.
    spectatorRegistry
        .counter(
            spectatorRegistry
                .createId("server.ssl.handshake")
                .withTag("success", Boolean.toString(sslEvent.isSuccess()))
                .withTag("clientAuth", info.getClientAuth().name())
                .withTag("protocol", info.getProtocol())
                .withTag("cipher", info.getCipherSuite()))
        .increment();
  }

  private ClientAuth whichClientAuthEnum(SslHandler sslhandler) {
    switch (sslhandler.engine().getNeedClientAuth() ? 2 : 
sslhandler.engine().getWantClientAuth()
        ? 1
        : 0) {
      case 2:
        return ClientAuth.REQUIRE;
      case 1:
        return ClientAuth.OPTIONAL;
      default:
        return ClientAuth.NONE;
    }
  }

  @Override
  public void exceptionCaught(ChannelHandlerContext ctx, Throwable cause) throws
Exception {
    if (cause instanceof ClosedChannelException) {
      logger.debug(
          "SSL handshake failed due to channel closed. {}",
          ChannelUtils.channelInfoForLogging(ctx.channel(), cause));
      CurrentPassport.fromChannel(ctx.channel())
          .add(PassportState.SERVER_CH_SSL_HANDSHAKE_FAILED);
    } else if (cause instanceof SSLException) {
      logger.debug(
          "SSL handshake failed. {}",
          ChannelUtils.channelInfoForLogging(ctx.channel(), cause));
      CurrentPassport.fromChannel(ctx.channel())
          .add(PassportState.SERVER_CH_SSL_HANDSHAKE_FAILED);
    } else {
      logger.error(
          "Error during SSL handshake. {}",
          ChannelUtils.channelInfoForLogging(ctx.channel(), cause));
      CurrentPassport.fromChannel(ctx.channel())
          .add(PassportState.SERVER_CH_SSL_HANDSHAKE_FAILED);
    }

    SourceAddressChannelHandler srcHandler =
        ctx.channel().pipeline().get(SourceAddressChannelHandler.class);
    if (srcHandler != null) {
      srcHandler.onHandshakeFailure(ctx, cause);
    }

    ctx.close();
  }

