		if (root.getArgs().isRenameValid()) {
			Set<String> keySet = new HashSet<>(keysCount);
			for (int i = 0; i < keysCount; i++) {
				String keyString = keyStrings[i];
				boolean isNew = keySet.add(keyString);
				if (!isNew) {
					keyStrings[i] = makeNewKeyName(i);
				}
			}
		}
}
