		if (root.getArgs().isRenamePrintable()) {
			for (int i = 0; i < keysCount; i++) {
				String keyString = keyStrings[i];
				if (!NameMapper.isAllCharsPrintable(keyString)) {
					keyStrings[i] = makeNewKeyName(i);
