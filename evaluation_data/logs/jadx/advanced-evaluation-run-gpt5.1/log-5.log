   		Set<String> tmpSet = new HashSet<>();
   		for (Map.Entry<String, ClspClass> entry : nnNameMap.entrySet()) {
   			ClspClass cls = entry.getValue();
   			tmpSet.clear();
   			addSuperTypes(cls, tmpSet);
   			Set<String> result;
   			if (tmpSet.isEmpty()) {
   				result = Collections.emptySet();
   			} else {
   				result = new HashSet<>(tmpSet);
