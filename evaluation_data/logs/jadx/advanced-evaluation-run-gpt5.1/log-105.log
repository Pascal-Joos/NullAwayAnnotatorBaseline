			memorizePackageName(attrName, str);
			if (isDeobfCandidateAttr(shortNsName, attrName)) {
				str = deobfClassName(str);
			}
			attachClassNode(writer, attrName, str);
			writer.add(str != null ? StringUtils.escapeXML(str) : "null");
		}
}

