			pkgName = classInfo.getPackage();
		}
		PackageNode pkg = getPackageNode(pkgName, true);
		clsMap.put(classInfo, new DeobfClsInfo(this, cls, pkg, alias));
		return alias;
}private void process() {
		preProcess();
		if (DEBUG) {
			dumpAlias();
		}
		for (ClassNode cls : root.getClasses()) {
			processClass(cls);
