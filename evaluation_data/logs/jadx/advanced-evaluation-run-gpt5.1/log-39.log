		if (insn instanceof TernaryInsn) {
			TernaryInsn ternaryInsn = (TernaryInsn) insn;
			for (RegisterArg arg : ternaryInsn.getCondition().getRegisterArgs()) {
				checkVar(mth, insn, arg);
			}
