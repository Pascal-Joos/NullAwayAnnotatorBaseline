     		if (nextIf != null) {
     			followThenBranch = true;
     		} else {
     			nextIf = getNextIf(currentIf, curElse);
     			if (nextIf != null) {
     				followThenBranch = false;
     			} else {
     				return null;
     			}
     		}
     
