     		if (assignInlineNeeded) {
     			for (BlockNode mergedBlock : currentIf.getMergedBlocks()) {
     				if (mergedBlock.contains(AFlag.LOOP_START)) {
     					// don't inline assigns into loop condition
     					return currentIf;
