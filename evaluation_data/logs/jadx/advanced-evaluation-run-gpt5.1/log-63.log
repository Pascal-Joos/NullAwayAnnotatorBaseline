class jadx.core.utils.BlockUtils {
@Nullable public static BlockNode followEmptyPath(BlockNode start) {
 		while (true) {
 			BlockNode next = getNextBlockOnEmptyPath(Nullability.castToNonnull(start));
 			if (next == null) {
 				return start;
 			}
 			start = next;
 		}
}@Nullable
	public static BlockNode getPathCross(MethodNode mth, BlockNode b1, BlockNode b2) {
		if (b1 == b2) {
			return b1;
		}
		if (b1 == null || b2 == null) {
			return null;
		}
		return getPathCross(mth, Arrays.asList(b1, b2));
}public static void visitBlocksOnEmptyPath(BlockNode start, Consumer<BlockNode> visitor) {
		while (true) {
			BlockNode next = getNextBlockOnEmptyPath(start);
			if (next == null) {
				return;
			}
			visitor.accept(next);
			start = next;
		}
}
}
