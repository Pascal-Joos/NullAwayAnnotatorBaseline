@Nullable static IfInfo mergeNestedIfNodes(  @Nullable IfInfo currentIf) {
     		BlockNode curThen = Nullability.castToNonnull(currentIf.getThenBlock());
     		BlockNode curElse = currentIf.getElseBlock();
     		if (curThen == curElse) {
     			return null;
     		}
