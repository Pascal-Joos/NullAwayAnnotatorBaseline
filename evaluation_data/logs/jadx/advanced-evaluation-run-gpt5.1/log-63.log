private static IfInfo mergeIfInfo(IfInfo first, IfInfo second, boolean followThenBranch) {
 		MethodNode mth = first.getMth();
 		Set<BlockNode> skipBlocks = first.getSkipBlocks();
 		BlockNode thenBlock;
 		BlockNode elseBlock;
 		if (followThenBranch) {
