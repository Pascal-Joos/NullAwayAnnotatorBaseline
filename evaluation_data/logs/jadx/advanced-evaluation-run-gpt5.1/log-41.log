 	public static BlockNode getNextBlockToPath(BlockNode block, BlockNode pathEnd) {
 		List<BlockNode> successors = block.getCleanSuccessors();
 		if (successors == null) {
 			return null;
 		}
 		if (successors.contains(pathEnd)) {
