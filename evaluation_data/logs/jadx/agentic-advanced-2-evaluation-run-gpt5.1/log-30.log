 				List<ArgType> newTypes = Utils.collectionMap(genericTypes, t -> {
 					ArgType type = replaceTypeVariablesUsingMap(t, replaceMap);
 					return type == null ? t : type;
 				});
 				return ArgType.generic(replaceType, newTypes);
 			}
 		}
 		return null;
}
}
