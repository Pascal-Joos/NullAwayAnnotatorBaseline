			if (boundType.isTypeKnown()
					&& !boundType.equals(var.getTypeInfo().getType())
					&& boundType.containsTypeVariable()
					&& !root.getTypeUtils().containsUnknownTypeVar(mth, boundType)) {
				if (insertAssignCast(mth, var, boundType)) {
