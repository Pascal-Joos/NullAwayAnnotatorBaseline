			varInfo.setCurrentType(ArgType.UNKNOWN);
			ArrayList<ArgType> types = new ArrayList<>(candidateTypes);
			types.sort(typeCompare.getReversedComparator());
			varInfo.setCandidateTypes(Collections.unmodifiableList(types));
