class jadx.core.dex.regions.conditions.IfCondition {
public static IfCondition invert(@Nullable IfCondition cond) {
		Mode mode = cond.getMode();
		switch (mode) {
			case COMPARE:
				return new IfCondition(cond.getCompare().invert());
			case TERNARY:
