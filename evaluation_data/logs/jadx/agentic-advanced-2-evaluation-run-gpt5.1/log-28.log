			}
		}
		if (isGeneric()) {
			List<ArgType> genericTypes = getGenericTypes();
			if (genericTypes != null) {
				for (ArgType genericType : genericTypes) {
					R res = genericType.visitTypes(visitor);
					if (res != null) {
						return res;
					}
				}
			}
		}
		return null;
}public boolean containsGeneric() {
