class jadx.core.dex.visitors.regions.CleanRegions {
public static void process(MethodNode mth) {
		if (mth.isNoCode() || mth.getBasicBlocks().isEmpty()) {
			return;
		}
		DepthRegionTraversal.traverse(mth, REMOVE_REGION_VISITOR);
}
}
