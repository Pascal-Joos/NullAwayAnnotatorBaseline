        /**
         * Method details not found => add cast for 'null' args
         */
        private void processUnknown(BaseInvokeNode invokeInsn) {
                int argsOffset = invokeInsn.getFirstArgOffset();
                List<ArgType> compilerVarTypes = 
collectCompilerVarTypes(invokeInsn, argsOffset);
                List<ArgType> castTypes = new ArrayList<>(compilerVarTypes);
                if (replaceUnknownTypes(castTypes, 
invokeInsn.getCallMth().getArgumentsTypes())) {
                        applyArgsCast(invokeInsn, argsOffset, compilerVarTypes, 
castTypes);
                }
        }

        @Nullable
        private ArgType getCallClassFromInvoke(MethodNode parentMth, 
BaseInvokeNode invokeInsn, MethodInfo callMth) {
                if (invokeInsn instanceof ConstructorInsn) {
                        ConstructorInsn constrInsn = (ConstructorInsn) 
invokeInsn;
                        if (constrInsn.isSuper()) {
                                return 
parentMth.getParentClass().getSuperClass();
                        }
                }
                InsnArg instanceArg = invokeInsn.getInstanceArg();
                if (instanceArg != null) {
                        return instanceArg.getType();
                }
                // static call
                return callMth.getDeclClass().getType();
        }

        private Map<ArgType, ArgType> getTypeVarsMapping(BaseInvokeNode 
invokeInsn) {
                RootNode root = Objects.requireNonNull(this.root);
                MethodInfo callMthInfo = invokeInsn.getCallMth();
                ArgType declClsType = callMthInfo.getDeclClass().getType();
                ArgType callClsType = getClsCallType(invokeInsn, declClsType);

                TypeUtils typeUtils = root.getTypeUtils();
                Map<ArgType, ArgType> clsTypeVars = 
typeUtils.getTypeVariablesMapping(callClsType);
                Map<ArgType, ArgType> mthTypeVars = 
typeUtils.getTypeVarMappingForInvoke(invokeInsn);
                return Utils.mergeMaps(clsTypeVars, mthTypeVars);
        }

        private ArgType getClsCallType(BaseInvokeNode invokeInsn, ArgType 
declClsType) {
                InsnArg instanceArg = invokeInsn.getInstanceArg();
                if (instanceArg != null) {
                        return instanceArg.getType();
                }
                if (invokeInsn.getType() == InsnType.CONSTRUCTOR && 
invokeInsn.getResult() != null) {
                        return invokeInsn.getResult().getType();
                }
                return declClsType;
        }

        private void applyArgsCast(BaseInvokeNode invokeInsn, int argsOffset, 
List<ArgType> compilerVarTypes, List<ArgType> castTypes) {
                int argsCount = invokeInsn.getArgsCount();
                for (int i = argsOffset; i < argsCount; i++) {
                        InsnArg arg = invokeInsn.getArg(i);
                        int origPos = i - argsOffset;
                        ArgType compilerType = compilerVarTypes.get(origPos);
                        ArgType castType = castTypes.get(origPos);
                        if (castType != null) {
                                if (!castType.equals(compilerType)) {
                                        if (arg.isLiteral() && 
compilerType.isPrimitive() && castType.isPrimitive()) {
                                                arg.setType(castType);
                                                arg.add(AFlag.EXPLICIT_PRIMITIVE
_TYPE);
                                        } else {
                                                InsnNode castInsn = new 
IndexInsnNode(InsnType.CAST, castType, 1);
                                                castInsn.addArg(arg);
                                                castInsn.add(AFlag.EXPLICIT_CAST
);
                                                InsnArg wrapCast = 
InsnArg.wrapArg(castInsn);
                                                wrapCast.setType(castType);
                                                invokeInsn.setArg(i, wrapCast);
                                        }
                                } else {
                                        // protect already existed cast
                                        if (arg.isInsnWrap()) {
                                                InsnNode wrapInsn = 
((InsnWrapArg) arg).getWrapInsn();
                                                if (wrapInsn.getType() == 
InsnType.CHECK_CAST) {
                                                        wrapInsn.add(AFlag.EXPLI
CIT_CAST);
                                                }
                                        }
                                }
                        }
                }
        }

        private List<ArgType> collectCompilerVarTypes(BaseInvokeNode invokeInsn,
int argsOffset) {
                int argsCount = invokeInsn.getArgsCount();
                List<ArgType> compilerVarTypes = new ArrayList<>(argsCount - 
argsOffset);
                for (int i = argsOffset; i < argsCount; i++) {
                        InsnArg arg = invokeInsn.getArg(i);
                        ArgType type = arg.getType();
                        if (type == null) {
                                throw new JadxRuntimeException("Null type for 
arg: " + arg + ", invoke: " + invokeInsn);
                        }
                        compilerVarTypes.add(type);
                }
                return compilerVarTypes;
        }

        private List<ArgType> searchCastTypes(MethodNode parentMth, 
IMethodDetails mthDetails,
                        List<IMethodDetails> overloadMethods, List<ArgType> 
compilerVarTypes) {
                List<ArgType> castTypes = new 
ArrayList<>(compilerVarTypes.size());
                for (int i = 0; i < compilerVarTypes.size(); i++) {
                        castTypes.add(null);
                }
                for (IMethodDetails overloadMth : overloadMethods) {
                        if (overloadMth == mthDetails) {
                                continue;
                        }
                        List<ArgType> overloadArgs = overloadMth.getArgTypes();
                        if (overloadArgs.size() != compilerVarTypes.size()) {
                                continue;
                        }
                        for (int i = 0; i < overloadArgs.size(); i++) {
                                ArgType overloadArgType = overloadArgs.get(i);
                                ArgType compilerType = compilerVarTypes.get(i);
                                if (compilerType == null || overloadArgType == 
null) {
                                        continue;
                                }
                                if (compilerType.equals(overloadArgType)) {
                                        continue;
                                }
                                if (compilerType.containsTypeVariable() || 
overloadArgType.containsTypeVariable()) {
                                        continue;
                                }
                                if (TypeCompare.isCastNeeded(compilerType, 
overloadArgType) == TypeCompareEnum.NEED_CAST) {
                                        ArgType castType = castTypes.get(i);
                                        if (castType == null) {
                                                castTypes.set(i, 
overloadArgType);
                                        } else {
                                                if 
(!castType.equals(overloadArgType)) {
                                                        // different cast types 
=> can't resolve
                                                        return castTypes;
                                                }
                                        }
                                }
                        }
                }
                return castTypes;
        }

        private boolean replaceUnknownTypes(List<ArgType> castTypes, 
List<ArgType> argsTypes) {
                boolean replaced = false;
                for (int i = 0; i < castTypes.size(); i++) {
                        ArgType castType = castTypes.get(i);
                        if (castType == null || castType.containsTypeVariable())
{
                                ArgType argType = argsTypes.get(i);
                                if (argType != null && 
!argType.containsTypeVariable()) {
                                        castTypes.set(i, argType);
                                        replaced = true;
                                }
                        }
                }
                return replaced;
        }

        private IMethodDetails resolveTypeVars(IMethodDetails mthDetails, 
Map<ArgType, ArgType> typeVarsMapping) {
                if (typeVarsMapping.isEmpty()) {
                        return mthDetails;
                }
                List<ArgType> argTypes = mthDetails.getArgTypes();
                List<ArgType> newArgTypes = new ArrayList<>(argTypes.size());
                for (ArgType argType : argTypes) {
                        newArgTypes.add(applyTypeVarsMapping(argType, 
typeVarsMapping));
                }
                return new MutableMethodDetails(mthDetails, newArgTypes);
        }

        private ArgType applyTypeVarsMapping(ArgType type, Map<ArgType, ArgType>
typeVarsMapping) {
                if (type == null) {
                        return null;
                }
                Function<ArgType, ArgType> replaceTypeVar = t -> {
                        ArgType mappedType = typeVarsMapping.get(t);
                        return mappedType != null ? mappedType : t;
                };
                return type.visitType(replaceTypeVar);
        }

        @Override
        public boolean visit(MethodNode mth, ICodeWriter code) {
                return false;
        }
}
