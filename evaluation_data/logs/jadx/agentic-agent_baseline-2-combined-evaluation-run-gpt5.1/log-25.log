                        case 2:
                                return TWO_BYTES_TYPE;
                        case 4:
                                return FOUR_BYTES_TYPE;
                        case 8:
                                return EIGHT_BYTES_TYPE;
                        default:
                                throw new JadxRuntimeException("Unknown array 
element width: " + elementWidthUnit);
                }
        }

