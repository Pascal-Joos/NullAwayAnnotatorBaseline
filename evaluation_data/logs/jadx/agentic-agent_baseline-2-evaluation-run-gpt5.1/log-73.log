package jadx.core.dex.visitors;

import java.util.Iterator;
import java.util.List;

import org.jetbrains.annotations.Nullable;

import jadx.core.dex.attributes.AFlag;
import jadx.core.dex.attributes.AType;
import jadx.core.dex.attributes.nodes.EnumClassAttr;
import jadx.core.dex.info.ClassInfo;
import jadx.core.dex.instructions.InsnType;
import jadx.core.dex.instructions.args.ArgType;
import jadx.core.dex.instructions.args.RegisterArg;
import jadx.core.dex.instructions.mods.ConstructorInsn;
import jadx.core.dex.nodes.BlockNode;
import jadx.core.dex.nodes.ClassNode;
import jadx.core.dex.nodes.FieldNode;
import jadx.core.dex.nodes.MethodNode;
import jadx.core.dex.nodes.RootNode;
import jadx.core.dex.visitors.shrink.CodeShrinkVisitor;
import jadx.core.utils.BlockUtils;
import jadx.core.utils.exceptions.JadxException;

@JadxVisitor(
                name = "ClassModifier",
                desc = "Remove synthetic classes and methods",
                runAfter = {
                                CodeShrinkVisitor.class
                }
)
public class ClassModifier extends AbstractVisitor {

        @Override
        public void visit(RootNode root) throws JadxException {
                for (ClassNode cls : root.getClasses()) {
                        processClass(cls);
                }
        }

        private static void processClass(ClassNode cls) {
                if (cls.contains(AFlag.DONT_GENERATE)) {
                        return;
                }
                if (isEmptySyntheticClass(cls)) {
                        cls.add(AFlag.DONT_GENERATE);
                        return;
                }
                removeSyntheticFields(cls);
                removeSyntheticMethods(cls);
        }

        private static boolean isEmptySyntheticClass(ClassNode cls) {
                if (!cls.getAccessFlags().isSynthetic()) {
                        return false;
                }
                if (!cls.getFields().isEmpty()) {
                        return false;
                }
                for (MethodNode mth : cls.getMethods()) {
                        if (!mth.getAccessFlags().isSynthetic()) {
                                return false;
                        }
                        if (!mth.getBasicBlocks().isEmpty()) {
                                return false;
                        }
                }
                return true;
        }

        private static void removeSyntheticFields(ClassNode cls) {
                Iterator<FieldNode> it = cls.getFields().iterator();
                while (it.hasNext()) {
                        FieldNode field = it.next();
                        if (field.getAccessFlags().isSynthetic()) {
                                if (field.getType().isObject()) {
                                        ClassNode fieldCls = 
cls.root().resolveClass(field.getType());
                                        if (fieldCls != null && 
(fieldCls.contains(AFlag.DONT_GENERATE) || isEmptySyntheticClass(fieldCls))) {
                                                it.remove();
                                                continue;
                                        }
                                }
                                if (field.getName().startsWith("this$")) {
                                        it.remove();
                                }
                        }
                }
        }

        private static void removeSyntheticMethods(ClassNode cls) {
                Iterator<MethodNode> it = cls.getMethods().iterator();
                while (it.hasNext()) {
                        MethodNode mth = it.next();
                        if (mth.getAccessFlags().isSynthetic()) {
                                if (mth.getBasicBlocks().isEmpty()) {
                                        it.remove();
                                        continue;
                                }
                                if (mth.getName().startsWith("access$")) {
                                        if (removeSyntheticAccessMethod(cls, 
mth)) {
                                                it.remove();
                                                continue;
                                        }
                                }
                                if (mth.isConstructor()) {
                                        if (isRemovedClassInArgs(cls, 
mth.getArgRegs())) {
                                                InsnNode insn = 
BlockUtils.getOnlyOneInsnFromMth(mth);
                                                if (insn != null) {
                                                        modifySyntheticMethod(cl
s, mth, insn, mth.getArgRegs());
                                                }
                                        }
                                }
                        }
                }
        }

        private static boolean isRemovedClassInArgs(ClassNode cls, 
List<RegisterArg> mthArgs) {
                for (RegisterArg arg : mthArgs) {
                        ArgType argType = arg.getType();
                        if (!argType.isObject()) {
                                continue;
                        }
                        ClassNode argCls = cls.root().resolveClass(argType);
                        if (argCls == null) {
                                // check if missing class from current top class
                                ClassInfo argClsInfo = 
ClassInfo.fromType(cls.root(), argType);
                                ClassInfo parentClsInfo = 
argClsInfo.getParentClass();
                                if (argClsInfo.isInner() && parentClsInfo != 
null
                                                && 
cls.getFullName().startsWith(parentClsInfo.getFullName())) {
                                        return true;
                                }
                        } else {
                                if (argCls.contains(AFlag.DONT_GENERATE) || 
isEmptySyntheticClass(argCls)) {
                                        return true;
                                }
                        }
                }
                return false;
        }

        /**
         * Remove synthetic constructor and redirect calls to existing 
constructor
         */
        private static void modifySyntheticMethod(ClassNode cls, MethodNode mth,
InsnNode insn, List<RegisterArg> args) {
                if (insn.getType() == InsnType.CONSTRUCTOR) {
                        ConstructorInsn constr = (ConstructorInsn) insn;
                        if (constr.isThis() && !args.isEmpty()) {
                                // remove first arg for non-static class 
(references to outer class)
                                RegisterArg firstArg = args.get(0);
                                if 
(firstArg.getType().equals(cls.getParentClass().getClassInfo().getType())) {
                                        SkipMethodArgsAttr.skipArg(mth, 0);
                                }
                                // remove unused args
                                int argsCount = args.size();
                                for (int i = 1; i < argsCount; i++) {
                                        RegisterArg arg = args.get(i);
                                        if (!arg.isAttrStorageEmpty()) {
                                                continue;
                                        }
                                        if (arg.getSVar() != null && 
!arg.getSVar().getUseList().isEmpty()) {
                                                continue;
                                        }
                                        SkipMethodArgsAttr.skipArg(mth, i);
                                }
                        }
                }
        }

        private static boolean removeSyntheticAccessMethod(ClassNode cls, 
MethodNode mth) {
                // existing implementation unchanged
                EnumClassAttr enumClassAttr = cls.get(AType.ENUM_CLASS);
                if (enumClassAttr != null) {
                        if (enumClassAttr.processEnumMethod(mth)) {
                                return true;
                        }
                }
                return false;
        }
}
