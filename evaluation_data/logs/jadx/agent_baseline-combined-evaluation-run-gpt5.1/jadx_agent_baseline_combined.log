        public static void deleteDir(Path dir) {
                if (!Files.exists(dir)) {
                        return;
                }
                try (Stream<Path> walk = Files.walk(dir)) {
                        walk.sorted((p1, p2) -> p2.compareTo(p1)) // delete 
children first
                                        .forEach(path -> {
                                                try {
                                                        Files.delete(path);
                                                } catch (IOException e) {
