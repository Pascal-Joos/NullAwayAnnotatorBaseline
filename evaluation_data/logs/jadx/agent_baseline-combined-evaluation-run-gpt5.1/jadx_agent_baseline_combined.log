        private void decode(XmlNode n) throws IOException {
                if (n.hasSource()) {
                        writer.attachSourceLine(n.getSource().getLineNumber());
                }
                writer.add(StringUtils.escapeXML(n.getText().trim()));
                if (n.hasElement()) {
