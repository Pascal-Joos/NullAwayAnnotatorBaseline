    65          @Override
    66          public boolean isSame(InsnNode obj) {
    67                  if (this == obj) {
    68                          return true;
    69                  }
    70                  if (!(obj instanceof TernaryInsn) || !super.isSame(obj))
{
    71                          return false;
    72                  }
    73                  TernaryInsn that = (TernaryInsn) obj;
    74                  return condition.equals(that.condition);
    75          }
    76  
    77          @Override
    78          public InsnNode copy() {
    79                  TernaryInsn copy = new TernaryInsn(condition, 
(RegisterArg) getResult(), getArg(0), getArg(1));
    80                  copy.condition = condition;
    81                  return copyCommonParams(copy);
    82          }
    83  
    84          @Override
    85          public void rebindArgs() {
    86                  super.rebindArgs();
    87                  for (RegisterArg reg : condition.getRegisterArgs()) {
    88                          InsnNode parentInsn = reg.getParentInsn();
    89                          if (parentInsn != null) {
    90                                  parentInsn.rebindArgs();
    91                          }
    92                  }
    93          }
    94  
    95          @Override
    96          public String toString() {
    97                  return InsnUtils.formatOffset(offset) + ": TERNARY"
    98                                  + getResult() + " = (" + condition + ") 
? " + getArg(0) + " : " + getArg(1);
    99          }
