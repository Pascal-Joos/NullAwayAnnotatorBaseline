 			}
 		}
 		if (Consts.DEBUG_FINALLY) {
 			LOG.debug("Result slices:\n{}", extractInfo);
 		}
 		if (!found) {
 			return false;
 		}
 		if (!checkSlices(extractInfo)) {
 			mth.addWarnComment("Finally extract failed");
 			return false;
 		}
 
 		// 'finally' extract confirmed, apply
 		apply(extractInfo);
 		allHandler.setFinally(true);
 
