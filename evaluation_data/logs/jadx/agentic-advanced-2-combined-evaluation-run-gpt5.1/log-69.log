				code.add("new ");
				useType(code, arrayType.getArrayRootElement());
				int k = 0;
				int argsCount = insn.getArgsCount();
				for (; k < argsCount; k++) {
					code.add('[');
					addArg(code, insn.getArg(k), false);
					code.add(']');
