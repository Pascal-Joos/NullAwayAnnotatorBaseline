			for (InsnArg insnArg : insn.getArguments()) {
				if (insnArg != arg && insnArg.isRegister()) {
					list.add(((RegisterArg) insnArg).getSVar());
				}
			}
		}
		return list;
}
@Nullable public SSAVar getSVar() {
		return sVar;
