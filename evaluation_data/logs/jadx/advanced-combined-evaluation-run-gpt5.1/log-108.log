 		String nsValue = getString(beginPrefix);
 		if (nsMap != null && StringUtils.notBlank(nsKey) && !Nullability.castToNonnull(nsMap).containsValue(nsValue)) {
 			nsMap.putIfAbsent(nsKey, nsValue);
 		}
 		namespaceDepth++;
}

