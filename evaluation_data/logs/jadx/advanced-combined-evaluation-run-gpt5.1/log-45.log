			Set<ArgType> typeVars = new HashSet<>(cls.getGenericTypeParameters());
			cls.visitParentClasses(parent -> typeVars.addAll(parent.getGenericTypeParameters()));
			return typeVars;
		}
		return cls.getGenericTypeParameters();
