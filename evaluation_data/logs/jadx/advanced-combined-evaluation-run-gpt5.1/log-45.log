 	private ClassInfo getClassForSuperCall(MethodInfo callMth) {
 		ArgType declClsType = callMth.getDeclClass().getType();
 		ClassNode parentNode = mth.getParentClass();
 		while (true) {
 			if (parentNode == null) {
 				return null;
