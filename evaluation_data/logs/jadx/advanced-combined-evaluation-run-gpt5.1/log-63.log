@Nullable private static BlockNode getBranchBlock(BlockNode first, BlockNode second, Set<BlockNode> skipBlocks, MethodNode mth) {
               		if (first == second) {
               			return second;
               		}
               		if (isEqualReturnBlocks(Nullability.castToNonnull(first), Nullability.castToNonnull(second))) {
               			skipBlocks.add(first);
               			return second;
               		}
               		BlockNode cross = BlockUtils.getPathCross(mth, Nullability.castToNonnull(first), Nullability.castToNonnull(second));
               		if (cross != null) {
               			BlockUtils.visitBlocksOnPath(mth, Nullability.castToNonnull(first), cross, skipBlocks::add);
               			BlockUtils.visitBlocksOnPath(mth, Nullability.castToNonnull(second), cross, skipBlocks::add);
               			skipBlocks.remove(cross);
               			return cross;
               		}
               		BlockNode firstSkip = BlockUtils.followEmptyPath(Nullability.castToNonnull(first));
               		BlockNode secondSkip = BlockUtils.followEmptyPath(Nullability.castToNonnull(second));
               		if (firstSkip == null) {
               			return null;
               		}
               		if (Nullability.castToNonnull(firstSkip).equals(Nullability.castToNonnull(secondSkip)) || isEqualReturnBlocks(Nullability.castToNonnull(firstSkip), Nullability.castToNonnull(secondSkip))) {
               			skipBlocks.add(first);
               			skipBlocks.add(second);
               			BlockUtils.visitBlocksOnEmptyPath(Nullability.castToNonnull(first), skipBlocks::add);
               			BlockUtils.visitBlocksOnEmptyPath(Nullability.castToNonnull(second), skipBlocks::add);
               			return Nullability.castToNonnull(secondSkip);
               		}
               		throw new JadxRuntimeException("Unexpected merge pattern");
}
