			ArgType outerType = getOuterType();
			if (outerType != null) {
				return outerType.containsTypeVariable();
			}
			return false;
		}
		if (isArray()) {
			ArgType arrayElement = getArrayElement();
			if (arrayElement != null) {
				return arrayElement.containsTypeVariable();
			}
		}
		return false;
}
