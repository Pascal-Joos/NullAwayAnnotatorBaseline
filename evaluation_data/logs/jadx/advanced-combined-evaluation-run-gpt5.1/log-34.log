				code.add('}');
				break;
			case ENCODED_ANNOTATION:
				formatAnnotation(code, (IAnnotation) value);
				break;

			default:
				throw new JadxRuntimeException("Can't decode value: " + encodedValue.getType() + " (" + encodedValue + ')');
		}
}
