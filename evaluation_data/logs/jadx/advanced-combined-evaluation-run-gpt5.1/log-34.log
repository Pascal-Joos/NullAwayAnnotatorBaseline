  				ArgType innerType = readArgType(in);
  				return ArgType.outerGeneric(outerType, Nullability.castToNonnull(innerType));
  
  			case GENERIC:
  				if (classes == null) {
  					throw new JadxRuntimeException("Classes not loaded");
