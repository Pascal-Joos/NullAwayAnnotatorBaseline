static IfInfo mergeNestedIfNodes( IfInfo currentIf) {
  		BlockNode curThen = currentIf.getThenBlock();
  		BlockNode curElse = Nullability.castToNonnull(currentIf.getElseBlock());
  		if (curThen == curElse) {
  			return null;
