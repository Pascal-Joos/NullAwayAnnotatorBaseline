class jadx.core.utils.BlockUtils {
@Nullable public static BlockNode followEmptyPath(BlockNode start) {
 		while (true) {
 			BlockNode next = getNextBlockOnEmptyPath(Nullability.castToNonnull(start));
 			if (next == null) {
 				return start;
 			}
 			start = next;
 		}
}public static boolean isPathExists(BlockNode start, BlockNode end) {
		if (start == end
				|| end.isDominator(start)
				|| start.getCleanSuccessors().contains(end)) {
			return true;
		}
		if (start.getPredecessors().contains(end)) {
			return false;
		}
		return traverseSuccessorsUntil(start, end, new BitSet(), true);
}
}
