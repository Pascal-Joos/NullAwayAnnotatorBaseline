			}
			return firstPrimitiveType.compareTo(secondPrimitiveType) > 0 ? WIDER : NARROW;
		}

		LOG.warn("Type compare function not complete, can't compare {} and {}", first, second);
		return TypeCompareEnum.CONFLICT;
}
