			RegisterArg callRegArg = callArgs.get(i);
			callRegArg.getSVar().setCodeVar(extArg.getSVar().getCodeVar());
		}
		code.add(" -> {");
		code.incIndent();
		callMthGen.addInstructions(code);

		code.decIndent();
		code.startLine('}');
}

