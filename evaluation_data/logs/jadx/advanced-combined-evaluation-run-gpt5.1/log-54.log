class jadx.core.dex.visitors.kotlin.ProcessKotlinInternals {
@Override
	public boolean visit(ClassNode cls) {
		if (kotlinIntrinsicsCls == null) {
			return false;
		}
		for (MethodNode mth : cls.getMethods()) {
			processMth(mth);
		}
		return true;
}
}
