 		if (cls == null) {
 			return null;
 		}
 		ClspMethod clspMethod = getMethodFromClass(cls, methodInfo);
 		if (clspMethod != null) {
 			return clspMethod;
 		}
 		// deep search
 		Set<ArgType> parents = cls.getParents();
 		if (parents == null) {
