		int regsCount = mth.getRegsCount();
		RenameState state = new RenameState(
				mth,
				mth.getEnterBlock(),
				new SSAVar[regsCount],
				new int[regsCount]);
		RegisterArg thisArg = mth.getThisArg();
		if (thisArg != null) {
			state.startVar(thisArg);
		}
		for (RegisterArg arg : mth.getArgRegs()) {
			state.startVar(arg);
		}
		return state;
}
}
