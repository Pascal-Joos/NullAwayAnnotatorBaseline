						if (fn != null) {
							boolean canMove = canReorder && singlePathBlocks.contains(block);
							fieldsInit.add(new FieldInitInfo(fn, putInsn, canMove));
							fieldInsn = true;
						}
					}
				}
				if (!fieldInsn && canReorder && !insn.canReorder()) {
					canReorder = false;
				}
			}
		}
		return fieldsInit;
}
}
