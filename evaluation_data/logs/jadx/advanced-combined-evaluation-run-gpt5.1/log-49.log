class jadx.core.utils.BlockUtils {
@Nullable
	private static BlockNode getNextBlockOnEmptyPath(BlockNode block) {
		if (!block.getInstructions().isEmpty() || block.getPredecessors().size() > 1) {
			return null;
		}
		List<BlockNode> successors = block.getCleanSuccessors();
		if (successors.size() != 1) {
			return null;
		}
		return successors.get(0);
}@SuppressWarnings("NullAway") public static BlockNode followEmptyPath(BlockNode start) {
 		while (true) {
 			BlockNode next = getNextBlockOnEmptyPath(Nullability.castToNonnull(start));
 			if (next == null) {
 				return start;
 			}
 			start = next;
 		}
}
}
