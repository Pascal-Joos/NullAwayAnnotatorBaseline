		Set<ArgType> assigns = new LinkedHashSet<>();
		Set<ArgType> uses = new LinkedHashSet<>();
		Set<ITypeBound> bounds = ssaVar.getTypeInfo().getBounds();
		for (ITypeBound bound : bounds) {
