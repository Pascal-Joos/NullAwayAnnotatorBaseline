				applySuccess = false;
			}
		}
		return applySuccess;
}private void fillTypeCandidates(SSAVar ssaVar) {
		TypeSearchVarInfo varInfo = state.getVarInfo(ssaVar);
		ArgType immutableType = ssaVar.getImmutableType();
		if (immutableType != null) {
			varInfo.markResolved(immutableType);
			return;
