		if (added != 0) {
			if (Consts.DEBUG_TYPE_INFERENCE) {
				mth.addDebugComment("Additional " + added + " cast instructions added to help type inference");
			}
			InitCodeVariables.rerun(mth);
			initTypeBounds(mth);
			return runTypePropagation(mth);
		}
		return false;
}

