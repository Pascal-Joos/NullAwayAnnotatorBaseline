class jadx.core.utils.Utils {
public static <K, V> Map<K, V> mergeMaps(Map<K, V> first, Map<K, V> second) {
		if (isEmpty(first)) {
			return second;
		}
		if (isEmpty(second)) {
			return first;
		}
		Map<K, V> result = new HashMap<>(first.size() + second.size());
		result.putAll(first);
		result.putAll(second);
		return result;
}
}
