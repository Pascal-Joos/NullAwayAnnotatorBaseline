class jadx.core.dex.instructions.args.InsnWrapArg {
InsnWrapArg(@NotNull InsnNode insn) {
		RegisterArg result = insn.getResult();
		this.type = result != null ? result.getType() : ArgType.UNKNOWN;
		this.wrappedInsn = insn;
