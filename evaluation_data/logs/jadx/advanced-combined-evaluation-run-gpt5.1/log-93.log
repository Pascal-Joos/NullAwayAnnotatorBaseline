			if (immutableType != null && !immutableType.equals(genericType)) {
				// can't change type
				// allow to iterate over not generified collection only for Object vars
				return varType.equals(ArgType.OBJECT);
			}
		}
		iterableArg.setType(genericType);
		return true;
}

