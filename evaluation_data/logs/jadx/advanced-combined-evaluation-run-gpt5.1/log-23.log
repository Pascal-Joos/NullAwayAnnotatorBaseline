@Override
	public boolean visit(ClassNode cls) throws JadxException {
		if (respectAccessModifiers) {
			return true;
		}
		int newVisFlag = fixClassVisibility(cls);
		if (newVisFlag != -1) {
			changeVisibility(cls, newVisFlag);
		}
		return true;
}
