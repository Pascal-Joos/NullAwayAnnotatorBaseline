		addInnerClasses(cls, jsonCls, classGen);

		if (!cls.getClassInfo().isInner()) {
			List<String> imports = Utils.collectionMap(classGen.getImports(), ClassInfo::getAliasFullName);
			Collections.sort(imports);
			jsonCls.setImports(imports);
		}
		return jsonCls;
}
