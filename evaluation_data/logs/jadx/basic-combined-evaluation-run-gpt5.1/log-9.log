	private void add(ICodeWriter code, CondStack stack, @Nullable IfCondition condition) throws CodegenException {
		stack.push(condition);
		switch (condition.getMode()) {
			case COMPARE:
				addCompare(code, stack, condition.getCompare());
				break;

