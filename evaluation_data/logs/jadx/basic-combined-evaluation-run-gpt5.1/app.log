		ArgType type = arg.getType();
		if (!type.isTypeKnown() || !type.isObject()) {
			return;
		}
		FieldFixInfo fieldFixInfo = fixInfoMap.get(type.getObject());
		if (fieldFixInfo == null || fieldFixInfo.fieldFixMap == null) {
