	private void attachMethodDetails(BaseInvokeNode insn) {
		IMethodDetails methodDetails = methodUtils.getMethodDetails(insn.getCallMth());
		if (methodDetails != null) {
			insn.addAttr(methodDetails);
		}
	}
}
