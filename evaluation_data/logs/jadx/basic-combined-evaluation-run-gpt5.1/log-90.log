		if (!checkInvoke(hasNextCall, "java.util.Iterator", "hasNext()Z")
				|| !checkInvoke(nextCall, "java.util.Iterator", "next()Ljava/lang/Object;")) {
			return false;
		}
		List<InsnNode> toSkip = new ArrayList<>();
		RegisterArg iterVar;
