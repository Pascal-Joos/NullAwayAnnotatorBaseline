public class MethodNode extends NotificationAttrNode implements IMethodDetails, 
ILoadable, ICodeNode, Comparable<MethodNode> {
        private static final Logger LOG = 
LoggerFactory.getLogger(MethodNode.class);

        private final MethodInfo mthInfo;
        private final ClassNode parentClass;
