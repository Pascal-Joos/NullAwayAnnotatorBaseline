                        return false;
                }
                InvokeCustomNode other = (InvokeCustomNode) obj;
                return handleType == other.handleType
                                && implMthInfo.equals(other.implMthInfo)
                                && callInsn.isSame(other.callInsn)
                                && inlineInsn == other.inlineInsn
                                && useRef == other.useRef;
        }

