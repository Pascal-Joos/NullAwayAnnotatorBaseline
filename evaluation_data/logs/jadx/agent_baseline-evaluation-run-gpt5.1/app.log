    37          private void parseClassSignature(ClassNode cls) {
    38                  SignatureParser sp = SignatureParser.fromNode(cls);
    39                  if (sp == null) {
    40                          return;
    41                  }
    42                  try {
    43                          List<ArgType> generics = 
sp.consumeGenericTypeParameters();
    44                          ArgType superClass = validateClsType(cls, 
sp.consumeType(), cls.getSuperClass());
    45                          List<ArgType> interfaces = cls.getInterfaces();
    46                          for (int i = 0; i < interfaces.size(); i++) {
    47                                  ArgType type = sp.consumeType();
    48                                  if (type != null) {
    49                                          interfaces.set(i, 
validateClsType(cls, type, interfaces.get(i)));
    50                                  } else {
    51                                          break;
    52                                  }
    53                          }
    54                          cls.updateGenericClsData(superClass, interfaces,
generics);
    55                  } catch (Exception e) {
    56                          cls.addWarnComment("Failed to parse class 
signature: " + sp.getSignature(), e);
    57                  }
    58          }
