{} from {}", callMth, mth);
                                return;
                        }
                        // remap args
                        InsnArg[] regs = new InsnArg[callMth.getRegsCount()];
                        for (int i = 0; i < regNums.length; i++) {
                                InsnArg arg = insn.getArg(i);
                                regs[regNums[i]] = arg;
                        }
                        // replace args
                        List<RegisterArg> inlArgs = new ArrayList<>();
                        inlCopy.getRegisterArgs(inlArgs);
