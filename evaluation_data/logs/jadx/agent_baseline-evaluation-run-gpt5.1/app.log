   113  
   114                          mth.updateTypeParameters(typeParameters); // 
apply before expand args
   115                          TypeUtils typeUtils = root.getTypeUtils();
   116                          ArgType retType = 
typeUtils.expandTypeVariables(mth, parsedRetType);
   117                          List<ArgType> argTypes = 
Utils.collectionMap(parsedArgTypes, t -> typeUtils.expandTypeVariables(mth, t));
   118  
   119                          if (!validateAndApplyTypes(mth, sp, retType, 
argTypes)) {
   120                                  // bad types -> reset typed parameters
   121                                  
mth.updateTypeParameters(Collections.emptyList());
   122                          }
   123                  } catch (Exception e) {
   124                          mth.addWarnComment("Failed to parse method 
signature: " + sp.getSignature(), e);
   125                  }
   126          }
