    60          @Nullable
    61          private ArgType validateClsType(ClassNode cls, ArgType 
candidateType, @Nullable ArgType currentType) {
    62                  if (!candidateType.isObject()) {
    63                          cls.addWarnComment("Incorrect class signature, 
class is not object: " + SignatureParser.getSignature(cls));
    64                          return currentType;
    65                  }
    66                  if (Objects.equals(candidateType.getObject(), 
cls.getClassInfo().getType().getObject())) {
    67                          cls.addWarnComment("Incorrect class signature, 
class is equals to this class: " + SignatureParser.getSignature(cls));
    68                          return currentType;
    69                  }
    70                  return candidateType;
    71          }
