                }
)
public class DeboxingVisitor extends AbstractVisitor {

        @Nullable
        private Set<MethodInfo> valueOfMths;

        @Override
        public void init(RootNode root) {

                valueOfMths.add(valueOfMth(root, ArgType.INT, 
"java.lang.Integer"));
                valueOfMths.add(valueOfMth(root, ArgType.BOOLEAN, 
