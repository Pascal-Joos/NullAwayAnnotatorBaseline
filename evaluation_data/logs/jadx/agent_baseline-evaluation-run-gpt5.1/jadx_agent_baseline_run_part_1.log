                this.nameGen = new NameGen(this);
                this.parentGen = null;
                this.imports = new java.util.LinkedHashSet<>();
                this.fallback = fallback;
        }

        private ClassGen(ClassNode cls, ClassGen parentGen) {
                this.cls = cls;
                this.root = cls.root();
                this.annotationGen = parentGen.annotationGen;
                this.nameGen = parentGen.nameGen;
                this.parentGen = parentGen;
                this.imports = parentGen.imports;
