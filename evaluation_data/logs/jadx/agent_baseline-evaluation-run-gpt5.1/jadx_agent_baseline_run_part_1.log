fieldNode) {
                List<MethodNode> useInMths = fieldNode.getUseIn();
                code.startLine("// use in methods - 
").add(Integer.toString(useInMths.size()));
                for (MethodNode useMth : useInMths) {
                        code.startLine("//  ").add(useMth.toString());
                }
        }

