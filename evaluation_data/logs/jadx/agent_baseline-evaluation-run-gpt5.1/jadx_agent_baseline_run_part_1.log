import jadx.core.dex.nodes.MethodNode;
import jadx.core.dex.nodes.RootNode;
import jadx.core.utils.exceptions.JadxRuntimeException;

public class JsonMappingGen {

        public static void dump(RootNode root) {
                List<ClassNode> classes = root.getClasses(false);
                JsonMapping mapping = new JsonMapping();
                mapping.setVersion("1.0");
                mapping.setApp("jadx");
                mapping.setPkg(root.getAppPackage());
                mapping.setClsCount(classes.size());
                mapping.setClasses(new ArrayList<>(classes.size()));

                for (ClassNode cls : classes) {
                        ClassInfo classInfo = cls.getClassInfo();
                        JsonClsMapping jsonCls = new JsonClsMapping();
                        jsonCls.setName(classInfo.getRawName());
                        jsonCls.setAlias(classInfo.getAliasFullName());
                        jsonCls.setInner(classInfo.isInner());
                        jsonCls.setJson(cls.getTopParentClass().getClassInfo().g
etAliasFullPath() + ".json");
                        if (classInfo.isInner()) {
                                jsonCls.setTopClass(cls.getTopParentClass().getC
lassInfo().getFullName());
                        }
                        addFields(cls, jsonCls);
                        addMethods(cls, jsonCls);
                        mapping.getClasses().add(jsonCls);
                }

                Gson gson = new GsonBuilder().setPrettyPrinting().create();
                File outFile = new File(root.getArgs().getOutDir(), 
"mapping.json");
                try {
                        JsonUtils.writeJsonToFile(gson, mapping, outFile);
                } catch (IOException e) {
                        throw new JadxRuntimeException("Failed to write mapping 
file: " + outFile, e);
                }
        }

        private static void addMethods(ClassNode cls, JsonClsMapping jsonCls) {
                List<MethodNode> methods = cls.getMethods();
                if (methods.isEmpty()) {
                        return;
                }
                jsonCls.setMethods(new ArrayList<>(methods.size()));
                List<JsonMthMapping> jsonMethods = jsonCls.getMethods();
                if (jsonMethods == null) {
