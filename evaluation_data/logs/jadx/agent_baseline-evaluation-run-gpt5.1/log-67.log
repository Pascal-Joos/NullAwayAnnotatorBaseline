                super(parent);
                this.info = info;
                this.header = header;
                this.conditionAtEnd = reversed;
                if (header != null) {
                        updateCondition(header);
                }
        }

        public LoopInfo getInfo() {
                return info;
        }

        @Nullable
        public BlockNode getHeader() {
                return header;
        }

        public boolean isEndless() {
                return header == null;
        }

        public IRegion getBody() {
                return body;
        }

