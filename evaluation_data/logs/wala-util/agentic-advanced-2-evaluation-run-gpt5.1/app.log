      int[] ar = A.elements;
      int ai = 0;
      int al = A.size;
      int[] br = B.elements;
      int bi = 0;
      int bl = B.size;
      int[] cr = new int[al];
      // allocate enough (i.e. too much)
      int ci = 0;
  
      while (ai < al && bi < bl) {
        int cmp = (ar[ai] - br[bi]);
  
        // (accept element when only found in 'a')
        if (cmp > 0) { // a greater
          bi++;
        } else if (cmp < 0) { // b greater
          cr[ci++] = ar[ai];
          ai++;
        } else {
          ai++;
          bi++;
        }
      }
  
      // append a's tail if any
      if (ai < al) {
        int tail = al - ai;
        System.arraycopy(ar, ai, cr, ci, tail);
        ci += tail;
      }
  
      // now compact cr to 'just enough'
      ar = new int[ci];
      System.arraycopy(cr, 0, ar, 0, ci); // ar := cr
      return ar;
}
