              int bi = 0;
              int bl = that.size;
              long[] cr = null; // allocate on demand
              int ci = 0;
          
              while (ai < al && bi < bl) {
                long cmp = (ar[ai] - br[bi]);
          
                // (accept element only on a match)
                if (cmp > 0) { // a greater
                  bi++;
                } else if (cmp < 0) { // b greater
                  ai++;
                } else {
                  if (cr == null) {
