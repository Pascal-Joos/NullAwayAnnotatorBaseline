      long[] ar = this.elements;
      int ai = 0;
      final int al = size();
      int bi = 0;
  
      // invariant: assume cr has same value as ar until cr is allocated.
      // we allocate cr lazily when we discover cr != ar.
      long[] cr = null;
      int ci = 0;
  
      while (ai < al && bi < thatSize) {
        long cmp = (ar[ai] - that[bi]);
  
        // (always accept element)
