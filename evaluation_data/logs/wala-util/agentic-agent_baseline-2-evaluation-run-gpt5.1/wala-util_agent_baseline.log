import java.util.ArrayList;
import java.util.Iterator;
import java.util.NoSuchElementException;
import javax.annotation.Nullable;

/**
 * This class implements depth-first search over a {@link Graph}, return an 
enumeration of the nodes
 * of the graph in order of increasing finishing time. This class follows the 
outNodes of the graph
 * nodes to define the graph, but this behavior can be changed by overriding the
getConnected
 * method.
