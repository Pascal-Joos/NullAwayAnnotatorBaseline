  public static SparseLongSet parse(String s) {
    if (s == null || s.trim().isEmpty() || s.equals("{}")) {
      return new SparseLongSet();
    }
    if (!s.startsWith("{") || !s.endsWith("}")) {
      throw new IllegalArgumentException("Bad set syntax: " + s);
    }
    String body = s.substring(1, s.length() - 1).trim();
    if (body.isEmpty()) {
      return new SparseLongSet();
    }
    StringTokenizer st = new StringTokenizer(body, ",");
    long[] vals = new long[st.countTokens()];
    int i = 0;
    while (st.hasMoreTokens()) {
      vals[i++] = Long.parseLong(st.nextToken().trim());
    }
    return new SparseLongSet(vals);
