public static int[] diffInternal(SparseIntSet A, SparseIntSet B) {
        if (A == null) {
          throw new IllegalArgumentException("A is null");
        }
        if (B == null) {
          throw new IllegalArgumentException("B is null");
        }
        if (A.isEmpty()) {
          return new int[0];
        } else if (B.isEmpty()) {
          int[] newElts = new int[A.size];
          if (A.elements != null) {
            System.arraycopy(A.elements, 0, newElts, 0, A.size);
          }
          return newElts;
        } else if (A.equals(B)) {
          return new int[0];
        } else if (A.sameValue(B)) {
          return new int[0];
        }
    
        if (A.elements == null) {
          return new int[0];
        }
        if (B.elements == null) {
          int[] newElts = new int[A.size];
          System.arraycopy(A.elements, 0, newElts, 0, A.size);
          return newElts;
        }
    
        int[] ar = A.elements;
        int ai = 0;
        int al = A.size;
        int[] br = B.elements;
        int bi = 0;
        int bl = B.size;
