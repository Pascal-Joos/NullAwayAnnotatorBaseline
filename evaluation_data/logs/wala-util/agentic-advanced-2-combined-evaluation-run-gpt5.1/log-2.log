              edge2Var.put(x, getOut(y));
            } else {
              edge2Var.put(x, getEdge(y));
            }
          }
        }
      }
    }
}private void shortCircuitUnaryMeets(
      Graph<T> G, ITransferFunctionProvider<T, V> functions, UnionFind uf) {
    for (T node : G) {
