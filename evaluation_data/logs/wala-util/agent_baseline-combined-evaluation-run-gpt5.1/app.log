    11  package com.ibm.wala.util.collections;
    12  
    13  import java.util.ArrayList;
    14  import java.util.Arrays;
    15  import java.util.Iterator;
    16  import javax.annotation.Nullable;
    17  
    18  /** simple implementation of IVector */
    19  public class SimpleVector<T> implements IVector<T> {
    20  
    21    private static final int MAX_SIZE = Integer.MAX_VALUE / 4;
    22  
    23    private static final double GROWTH_FACTOR = 1.5;
    24  
    25    Object[] store = new Object[1];
    26  
    27    int maxIndex = -1;
    28  
    29    public SimpleVector() {}
    30  
    31    /**
    32     * @see com.ibm.wala.util.intset.IntVector#get(int)
    33     */
    34    @Override
    35    @SuppressWarnings("unchecked")
    36    public T get(int x) {
    37      if (x < 0) {
    38        throw new IllegalArgumentException("illegal x: " + x);
    39      }
    40      if (x < store.length) {
    41        return (T) store[x];
    42      } else {
    43        return null;
    44      }
    45    }
    46  
    47    /**
    48     * @see com.ibm.wala.util.intset.IntVector#set(int, int)
    49     */
    50    @Override
    51    public void set(int x, @Nullable T value) {
    52      if (x < 0) {
    53        throw new IllegalArgumentException("illegal x value " + x);
    54      }
    55      if (x > MAX_SIZE) {
    56        throw new IllegalArgumentException("x is too big: " + x);
    57      }
    58      maxIndex = Math.max(maxIndex, x);
    59      if (value == null) {
    60        if (x >= store.length) {
    61          return;
    62        } else {
    63          store[x] = null;
    64        }
    65      } else {
    66        ensureCapacity(x);
    67        store[x] = value;
    68      }
    69    }
    70  
    71    /** make sure we can store to a particular index */
    72    private void ensureCapacity(int capacity) {
    73      if (capacity >= store.length) {
    74        store = Arrays.copyOf(store, 1 + (int) (GROWTH_FACTOR * 
capacity));
    75      }
    76    }
    77  
    78    @Override
    79    public void performVerboseAction() {
    80      System.err.println(("size:       " + store.length));
    81      System.err.println(("occupancy:  " + computeOccupancy()));
    82    }
    83  
    84    /**
    85     * @return the percentage of entries in delegateStore that are 
non-null
    86     */
    87    private double computeOccupancy() {
    88      int count = 0;
    89      for (Object element : store) {
    90        if (element != null) {
    91          count++;
    92        }
    93      }
    94      return (double) count / (double) store.length;
    95    }
    96  
    97    @Override
    98    @SuppressWarnings("unchecked")
    99    public Iterator<T> iterator() {
   100      ArrayList<T> result = new ArrayList<>();
   101      for (int i = 0; i <= maxIndex; i++) {
   102        result.add((T) store[i]);
   103      }
   104      return result.iterator();
   105    }
   106  
   107    @Override
   108    public int getMaxIndex() {
   109      return maxIndex;
   110    }
   111  }
