    29  public abstract class DFSFinishTimeIterator<T> extends ArrayList<T> 
implements Iterator<T> {
    30  
    31    private static final long serialVersionUID = 8440061593631309429L;
    32  
    33    /** the current next element in finishing time order */
    34    private T theNextElement;
    35  
    36    /** an enumeration of all nodes to search from */
    37    private Iterator<? extends T> roots;
    38  
    39    /** The governing graph. */
    40    private Graph<T> G;
    41  
    42    /** Subclasses must call this in the constructor! */
    43    @Initializer
    44    protected void init(Graph<T> G, Iterator<? extends T> nodes) {
    45      this.G = G;
    46      roots = nodes;
    47      if (roots.hasNext()) theNextElement = roots.next();
    48    }
    49  
    50    private boolean empty() {
