    70      add(elt);
    71    }
    72  
    73    private T peek() {
    74      return get(size() - 1);
    75    }
    76  
    77    private T pop() {
    78      T e = get(size() - 1);
    79      remove(size() - 1);
    80      return e;
    81    }
