    public boolean ackTaskReceived(String taskId) {
        LOGGER.debug("Ack received for task: {}", taskId);
        AtomicBoolean ackResult = new AtomicBoolean(false);
        try {
            ackResult.set(executionService.ackTaskReceived(taskId));
        } catch (Exception e) {
