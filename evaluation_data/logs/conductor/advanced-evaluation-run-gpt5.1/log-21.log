                    Monitors.recordTaskExecutionTime(
                            task.getTaskDefName(), lastDuration, false, task.getStatus());
                }
        
                if (!isLazyEvaluateWorkflow(workflowInstance.getWorkflowDefinition(), task)) {
                    decide(workflowId);
                }
