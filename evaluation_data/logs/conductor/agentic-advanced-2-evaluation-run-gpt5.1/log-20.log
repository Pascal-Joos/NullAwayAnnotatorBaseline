            }
            for (String joinOnRef : joinOn) {
                TaskModel forkedTask = workflow.getTaskByRefName(joinOnRef);
                if (forkedTask == null) {
                    // Task is not even scheduled yet
                    allDone = false;
                    break;
                }
                TaskModel.Status taskStatus = forkedTask.getStatus();
                if (taskStatus == null) {
                    allDone = false;
                    break;
