                            task.getStatus());
        
                    boolean isTaskAsyncComplete = systemTask.isAsyncComplete(task);
                    if (task.getStatus() == TaskModel.Status.SCHEDULED || !isTaskAsyncComplete) {
                        task.incrementPollCount();
                    }
        
                    if (task.getStatus() == TaskModel.Status.SCHEDULED) {
