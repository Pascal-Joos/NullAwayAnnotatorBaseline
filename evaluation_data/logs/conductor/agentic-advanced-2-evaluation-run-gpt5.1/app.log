                TaskModel last = forkedTasks.get(forkedTasks.size() - 1);
                joinOnTaskRefs.add(last.getReferenceTaskName());
            }
    
            WorkflowDef workflowDef =
                    Optional.ofNullable(workflowModel.getWorkflowDefinition())
                            .orElseThrow(
                                    () ->
