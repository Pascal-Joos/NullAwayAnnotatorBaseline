                    if ((taskType != null && taskType.equalsIgnoreCase(TaskType.JOIN.toString()))
                            || (taskType != null && taskType.equalsIgnoreCase(TaskType.DO_WHILE.toString()))) {
                        task.setStatus(IN_PROGRESS);
