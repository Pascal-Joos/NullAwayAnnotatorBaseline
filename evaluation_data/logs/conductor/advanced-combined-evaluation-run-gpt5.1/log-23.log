                        .filter(UNSUCCESSFUL_JOIN_TASK)
                        .peek(
                                task -> {
                                    task.setStatus(TaskModel.Status.IN_PROGRESS);
                                    addTaskToQueue(task);
                                })
                        .forEach(executionDAOFacade::updateTask);
            }
        }
}

