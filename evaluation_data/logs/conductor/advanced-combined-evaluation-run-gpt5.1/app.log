                        if (relevantTask == null || t.getRetryCount() > relevantTask.getRetryCount()) {
                            relevantTasks.put(t.getReferenceTaskName(), t);
                        }
                    }
                }
                Collection<TaskModel> loopOverTasks = relevantTasks.values();
        
