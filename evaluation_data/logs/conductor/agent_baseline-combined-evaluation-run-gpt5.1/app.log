         * @throws NullPointerException if any required field is null
         */
        public TaskMapperContext build() {
            this.workflowModel = Objects.requireNonNull(this.workflowModel, 
"workflowModel");
            this.workflowTask = Objects.requireNonNull(this.workflowTask, 
"workflowTask");
            this.taskInput = Objects.requireNonNull(this.taskInput, 
"taskInput");
            this.taskId = Objects.requireNonNull(this.taskId, "taskId");
            this.deciderService = Objects.requireNonNull(this.deciderService, 
"deciderService");
            return new TaskMapperContext(this);
        }
    }
}
