          Object data = rewinder.rewindAndGet();
          Encoder<Object> encoder = helper.getSourceEncoder(data);
          DataCacheWriter<Object> writer = new DataCacheWriter<>(encoder, data, helper.getOptions());
          LoadData<?> local = loadData;
