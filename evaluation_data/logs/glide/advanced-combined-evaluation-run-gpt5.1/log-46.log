                transformation,
                resourceClass,
                helper.getOptions());
        cacheFile = helper.getDiskCache().get(currentKey);
        if (cacheFile != null) {
          sourceKey = sourceId;
          modelLoaders = helper.getModelLoaders(cacheFile);
          modelLoaderIndex = 0;
        } else {
          modelLoaders = null;
        }
      }

      loadData = null;
      boolean started = false;
      while (!started && hasNextModelLoader() && cacheFile != null) {
