                  + "x"
                  + expectedHeight
                  + "] for source"
                  + " ["
                  + sourceWidth
                  + "x"
                  + sourceHeight
                  + "]"
                  + ", sampleSize: "
                  + sampleSize
                  + ", targetDensity: "
