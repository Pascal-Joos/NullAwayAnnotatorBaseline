    50        DataRewinder<Data> rewinder,
    51        @NonNull Options options,
    52        int width,
    53        int height,
    54        DecodePath.DecodeCallback<ResourceType> decodeCallback)
    55        throws GlideException {
    56      List<Throwable> throwables = 
Preconditions.checkNotNull(listPool.acquire());
    57      try {
