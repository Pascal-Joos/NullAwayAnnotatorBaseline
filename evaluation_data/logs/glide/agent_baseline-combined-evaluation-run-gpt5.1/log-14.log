    30    public LoadPath(
    31        Class<Data> dataClass,
    32        Class<ResourceType> resourceClass,
    33        Class<Transcode> transcodeClass,
    34        List<DecodePath<Data, ResourceType, Transcode>> decodePaths,
    35        @Nullable Pool<List<Throwable>> listPool) {
