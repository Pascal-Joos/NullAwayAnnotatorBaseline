            float cosDeg = MathUtils.cosDeg(spawnAngle);
            float sinDeg = MathUtils.sinDeg(spawnAngle);
            x += cosDeg * radiusX;
            y += sinDeg * radiusX / scaleY;
            if ((updateFlags & UPDATE_ANGLE) == 0) {
