  public BitmapFontCache(BitmapFont font, boolean integer) {
    this.font = font;
    this.integer = integer;

    int pageCount = font.regions.size;
    if (pageCount == 0)
      throw new IllegalArgumentException(
          "The specified font must contain at least one texture page.");

