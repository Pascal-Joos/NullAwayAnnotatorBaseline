  @Nullable
  public static Node getNode(
      final Array<Node> nodes, @Nullable final String id, boolean recursive, boolean ignoreCase) {
    final int n = nodes.size;
    Node node;
    if (ignoreCase) {
      for (int i = 0; i < n; i++) {
        node = nodes.get(i);
        if (node != null && node.id != null && node.id.equalsIgnoreCase(id)) return node;
