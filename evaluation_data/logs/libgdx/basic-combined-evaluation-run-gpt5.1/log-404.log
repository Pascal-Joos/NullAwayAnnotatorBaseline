   * Creates a new map with a load factor of 0.8.
   *
   * @param initialCapacity The backing array size is initialCapacity / loadFactor, increased to the
   *     next power of two.
   */
  public ObjectLongMap(int initialCapacity) {
    this(initialCapacity, 0.8f);
