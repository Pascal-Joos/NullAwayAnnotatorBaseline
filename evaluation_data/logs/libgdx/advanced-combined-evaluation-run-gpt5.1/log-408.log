      if (assetData.type == ParticleEffect.class) {
        descriptors.add(new AssetDescriptor(assetData.filename, assetData.type, parameter));
      } else descriptors.add(new AssetDescriptor(assetData.filename, assetData.type));
    }

    return descriptors;
}
