      Array<Decal> targetGroup = groupList.get(groupIndex);
      if (targetGroup == null) {
        targetGroup = groupPool.obtain();
        targetGroup.clear();
        usedGroups.add(targetGroup);
        groupList.insert(groupIndex, targetGroup);
      }
      targetGroup.add(decal);
  }
