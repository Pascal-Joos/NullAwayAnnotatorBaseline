    final GLTexture texture = textureDesc.texture;
    reused = false;

    switch (method) {
      case ROUNDROBIN:
        result = offset + (idx = bindTextureRoundRobin(texture));
        break;
      case LRU:
        result = offset + (idx = bindTextureLRU(texture));
        break;
      default:
        return -1;
    }

