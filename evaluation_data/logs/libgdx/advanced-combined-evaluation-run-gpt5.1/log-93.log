      meshPart.id = part.id;
      meshPart.primitiveType = part.primitiveType;
      meshPart.offset = offset;
      meshPart.size = hasIndices ? part.indices.length : numVertices;
      meshPart.mesh = mesh;
      if (hasIndices) {
        mesh.getIndicesBuffer().put(part.indices);
