    float[] expandWidth = this.expandWidth = ensureSize(this.expandWidth, columns);
    float[] expandHeight = this.expandHeight = ensureSize(this.expandHeight, rows);

    float spaceRightLast = 0;
    for (int i = 0; i < cellCount; i++) {
