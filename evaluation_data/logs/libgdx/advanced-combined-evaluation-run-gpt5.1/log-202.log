      area += a;
      x += (x1 + x2) * a;
      y += (y1 + y2) * a;
      x1 = x2;
      y1 = y2;
    }
    if (area == 0) {
      centroid.x = 0;
      centroid.y = 0;
    } else {
      area *= 0.5f;
      centroid.x = x / (6 * area);
      centroid.y = y / (6 * area);
    }
    return centroid;
}

