      float angleTo) {
    tmpV1.set(normalX, normalY, normalZ).crs(0, 0, 1);
    tmpV2.set(normalX, normalY, normalZ).crs(0, 1, 0);
    if (tmpV2.len2() > tmpV1.len2()) tmpV1.set(tmpV2);
    tmpV2.set(tmpV1.nor()).crs(normalX, normalY, normalZ).nor();
    build(
        builder,
        width,
        height,
        innerWidth,
        innerHeight,
        divisions,
        centerX,
        centerY,
        centerZ,
