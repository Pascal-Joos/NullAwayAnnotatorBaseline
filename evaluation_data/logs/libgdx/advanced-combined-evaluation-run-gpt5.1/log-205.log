class com.badlogic.gdx.graphics.g3d.utils.shapebuilders.EllipseShapeBuilder {
public static void build(
      MeshPartBuilder builder,
      float width,
      float height,
      float innerWidth,
      float innerHeight,
      int divisions,
      float centerX,
      float centerY,
      float centerZ,
      float normalX,
      float normalY,
      float normalZ,
