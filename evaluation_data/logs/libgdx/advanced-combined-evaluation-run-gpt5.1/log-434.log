                if (tileImageElement != null) {
                  String imageSource = tileImageElement.getAttribute("source");
                  FileHandle image = getRelativeFileHandle(tmxFile, imageSource);
                  fileHandles.add(image);
                }
              }
            }
          }
        }
    
