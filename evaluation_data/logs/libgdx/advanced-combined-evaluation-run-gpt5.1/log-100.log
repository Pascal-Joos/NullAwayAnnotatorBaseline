      mesh.id = meshId;
      mesh.attributes = attributes.toArray(VertexAttribute.class);
      mesh.vertices = finalVerts;
      mesh.parts = new ModelMeshPart[] {part};
      data.nodes.add(node);
      data.meshes.add(mesh);
