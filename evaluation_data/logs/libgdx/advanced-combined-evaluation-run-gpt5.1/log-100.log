          jsonPart.primitiveType = parseType(type);

          jsonPart.indices = meshPart.require("indices").asShortArray();
          parts.add(jsonPart);
        }
        jsonMesh.parts = parts.toArray(ModelMeshPart.class);
        model.meshes.add(jsonMesh);
      }
    }
}
