    ResourceData<ParticleEffect> effectData = null;
    synchronized (items) {
      for (int i = 0; i < items.size; ++i) {
        ObjectMap.Entry<String, ResourceData<ParticleEffect>> entry = items.get(i);
        if (entry.key.equals(fileName)) {
          effectData = entry.value;
          items.removeIndex(i);
          break;
