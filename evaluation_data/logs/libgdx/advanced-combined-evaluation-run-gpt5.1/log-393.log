          writeObjectEnd();
        } else {
          writer.value(convertToString((Enum) value));
        }
        return;
      }

      writeObjectStart(actualType, knownType);
      writeFields(value);
      writeObjectEnd();
    } catch (IOException ex) {
      throw new SerializationException(ex);
    }
