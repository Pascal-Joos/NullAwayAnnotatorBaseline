       final Pool<Transform> pool,
      final float alpha,
      final Animation animation,
      final float time) {

    if (out == null) {
      for (final NodeAnimation nodeAnim : animation.nodeAnimations)
        applyNodeAnimationDirectly(nodeAnim, time);
    } else {
      for (final Node node : out.keys()) node.isAnimated = false;
      for (final NodeAnimation nodeAnim : animation.nodeAnimations)
        applyNodeAnimationBlending(nodeAnim, out, Nullability.castToNonnull(pool), alpha, time);
      for (final ObjectMap.Entry<Node, Transform> e : out.entries()) {
        if (!e.key.isAnimated) {
          e.key.isAnimated = true;
          Transform transform = e.value;
          if (transform != null)
            transform.lerp(e.key.translation, e.key.rotation, e.key.scale, alpha);
        }
      }
    }
}
