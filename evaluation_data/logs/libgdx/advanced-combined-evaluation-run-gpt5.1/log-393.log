        }
        writeObjectEnd();
        return;
      }
      if (value instanceof LongMap) {
        if (knownType == null) knownType = LongMap.class;
        writeObjectStart(actualType, knownType);
        for (LongMap.Entry entry : ((LongMap<?>) value).entries()) {
