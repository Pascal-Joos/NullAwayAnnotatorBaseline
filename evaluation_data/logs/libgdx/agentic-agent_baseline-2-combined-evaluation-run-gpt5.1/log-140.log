    38    public ParticleControllerFinalizerInfluencer() {}
    39  
    40    @Initializer
    41    @Override
    42    public void init() {
    43      controllerChannel = 
controller.particles.getChannel(ParticleChannels.ParticleController);
    44      if (controllerChannel == null)
    45        throw new GdxRuntimeException(
    46            "ParticleController channel not found, specify an influencer 
which will allocate it please.");
    47      scaleChannel = 
controller.particles.getChannel(ParticleChannels.Scale);
    48      rotationChannel = 
controller.particles.getChannel(ParticleChannels.Rotation3D);
    49      hasScale = scaleChannel != null;
    50      hasRotation = rotationChannel != null;
    51    }
    52  
    53    @Override
    54    public void allocateChannels() {
    55      positionChannel = 
controller.particles.addChannel(ParticleChannels.Position);
    56    }
