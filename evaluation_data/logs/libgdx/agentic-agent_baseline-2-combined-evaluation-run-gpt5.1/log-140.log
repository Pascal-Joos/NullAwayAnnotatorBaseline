    59    public void update() {
    60      for (int i = 0, positionOffset = 0, c = controller.particles.size;
    61          i < c;
    62          ++i, positionOffset += positionChannel.strideSize) {
    63        ParticleController particleController = controllerChannel.data[i];
    64        float scale = hasScale ? scaleChannel.data[i] : 1;
    65        float qx = 0, qy = 0, qz = 0, qw = 1;
    66        if (hasRotation) {
    67          int rotationOffset = i * rotationChannel.strideSize;
    68          qx = rotationChannel.data[rotationOffset + 
ParticleChannels.XOffset];
    69          qy = rotationChannel.data[rotationOffset + 
ParticleChannels.YOffset];
    70          qz = rotationChannel.data[rotationOffset + 
ParticleChannels.ZOffset];
    71          qw = rotationChannel.data[rotationOffset + 
ParticleChannels.WOffset];
    72        }
    73        particleController.setTransform(
    74            positionChannel.data[positionOffset + 
ParticleChannels.XOffset],
    75            positionChannel.data[positionOffset + 
ParticleChannels.YOffset],
    76            positionChannel.data[positionOffset + 
ParticleChannels.ZOffset],
    77            qx,
    78            qy,
    79            qz,
    80            qw,
    81            scale);
    82        particleController.update();
    83      }
    84    }
