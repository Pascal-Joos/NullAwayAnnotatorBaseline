    33  public class ParticleControllerFinalizerInfluencer extends Influencer {
    34    FloatChannel positionChannel, scaleChannel, rotationChannel;
    35    ObjectChannel<ParticleController> controllerChannel;
    36    boolean hasScale, hasRotation;
