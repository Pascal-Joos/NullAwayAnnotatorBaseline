      case 2:
        if (numIndices > 0) {
          for (int i = offset; i < end; i++) {
            final int idx = (index.get(i) & 0xFFFF) * vertexSize + posoff;
            tmpV.set(verts.get(idx), verts.get(idx + 1), 0);
            if (transform != null) tmpV.mul(transform);
