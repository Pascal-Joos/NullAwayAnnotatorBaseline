@Override
  public void load(AssetManager manager, ResourceData resources) {
    super.load(manager, resources);
    SaveData data = resources.getSaveData(ASSET_DATA);
    if (data == null) {
      return;
    }
    TextureAtlas atlas;
    atlas = (TextureAtlas) manager.get(data.loadAsset());
