        for (int i = 0, n = array.size; i < n; i++) writeValue(array.get(i), elementType, null);
        writeArrayEnd();
        return;
      }
      if (value instanceof Queue) {
        if (knownType != null && actualType != knownType && actualType != Queue.class)
          throw new SerializationException(
