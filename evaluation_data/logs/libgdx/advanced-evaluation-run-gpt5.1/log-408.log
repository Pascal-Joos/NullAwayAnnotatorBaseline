    if (parameter != null) {
      if (parameter.batches != null) {
        for (ParticleBatch<?> batch : parameter.batches) {
          batch.load(manager, effectData);
        }
      }
      effectData.resource.setBatch(parameter.batches);
    }
    return effectData.resource;
