              if (x > right - border) edge |= Align.right;
              if (y < bottom + border) edge |= Align.bottom;
              if (edge != 0) border += 25;
              if (x < left + border) edge |= Align.left;
              if (x > right - border) edge |= Align.right;
              if (y < bottom + border) edge |= Align.bottom;
            }
            if (isMovable
                && edge == 0
                && y <= height
                && y >= height - padTop
                && x >= left
                && x <= right) edge = MOVE;
          }

          public boolean touchDown(InputEvent event, float x, float y, int pointer, int button) {
            if (button == 0) {
              updateEdge(x, y);
