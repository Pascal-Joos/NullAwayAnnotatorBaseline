            float border = resizeBorder / 2f;
            float width = getWidth(), height = getHeight();
            float padTop = getPadTop(),
                padLeft = getPadLeft(),
                padBottom = getPadBottom(),
                padRight = getPadRight();
            float left = padLeft, right = width - padRight, bottom = padBottom;
            edge = 0;
