    addActor(titleTable);

    setStyle(style);
    setWidth(150);
    setHeight(150);

    addCaptureListener(
        new InputListener() {
          public boolean touchDown(InputEvent event, float x, float y, int pointer, int button) {
            toFront();
            return false;
          }
        });
    addListener(
