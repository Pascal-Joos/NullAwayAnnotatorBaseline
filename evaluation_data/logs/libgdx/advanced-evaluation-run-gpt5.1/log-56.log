      page.texture.setFilter(page.minFilter, page.magFilter);
      page.texture.setWrap(page.uWrap, page.vWrap);
      textures.add(page.texture);
    }

    regions.ensureCapacity(data.regions.size);
    for (Region region : data.regions) {
