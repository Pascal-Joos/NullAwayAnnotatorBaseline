        prefWidth = Math.max(layout.width, prefWidth);
      }
      layoutPool.free(layout);
      prefWidth += selectedDrawable.getLeftWidth() + selectedDrawable.getRightWidth();
      prefHeight = items.size * itemHeight;
  
