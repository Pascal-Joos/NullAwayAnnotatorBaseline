      // height in the stage.
      float itemHeight = list.getItemHeight();
      float height =
          itemHeight
              * (maxListCount <= 0
                  ? selectBox.items.size
                  : Math.min(maxListCount, selectBox.items.size));
      Drawable scrollPaneBackground = getStyle().background;
      if (scrollPaneBackground != null)
