        request,
        new Net.HttpResponseListener() {
          @Override
          public void handleHttpResponse(Net.HttpResponse httpResponse) {
            final byte[] result = httpResponse.getResult();
            Gdx.app.postRunnable(
                new Runnable() {
                  @Override
