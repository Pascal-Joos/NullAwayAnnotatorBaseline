    this.mapTileWidth = tileWidth;
    this.mapTileHeight = tileHeight;
    this.mapWidthInPixels = mapWidth * tileWidth;
    this.mapHeightInPixels = mapHeight * tileHeight;

    if (mapOrientation != null) {
      if ("staggered".equals(mapOrientation)) {
