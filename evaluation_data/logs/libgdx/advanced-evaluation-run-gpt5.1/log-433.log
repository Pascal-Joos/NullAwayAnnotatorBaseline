      for (int i = 0; i < array.length; i++) ids[i] = (int) Long.parseLong(array[i].trim());
    } else {
      if (true)
        if (encoding.equals("base64")) {
          InputStream is = null;
          try {
            String compression = data.getAttribute("compression", null);
            byte[] bytes = Base64Coder.decode(data.getText());
            if (compression == null) is = new ByteArrayInputStream(bytes);
            else if (compression.equals("gzip"))
              is =
                  new BufferedInputStream(
                      new GZIPInputStream(new ByteArrayInputStream(bytes), bytes.length));
            else if (compression.equals("zlib"))
              is =
                  new BufferedInputStream(new InflaterInputStream(new ByteArrayInputStream(bytes)));
