            z3 = vertices[p3Offset + 2];
        float area = Math.abs((x1 * (y2 - y3) + x2 * (y3 - y1) + x3 * (y1 - y2)) / 2f);
        distribution.add(new Triangle(x1, y1, z1, x2, y2, z2, x3, y3, z3), area);
      }
    }

