          int imageIndex = -1;
          String imageName = name;

          if (useIndexes) {
            Matcher matcher = indexPattern.matcher(imageName);
            if (matcher.matches()) {
              imageName = matcher.group(1);
              imageIndex = Integer.parseInt(matcher.group(2));
