    Class type = object.getClass();
    OrderedMap<String, FieldMetadata> fields = getFields(type);
    for (JsonValue child = jsonMap.child; child != null; child = child.next) {
      FieldMetadata metadata = fields.get(child.name().replace(" ", "_"));
      if (metadata == null) {
