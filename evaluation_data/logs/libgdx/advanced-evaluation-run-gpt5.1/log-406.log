          writeValue(value, field.getType(), Nullability.castToNonnull(metadata).elementType);
        } catch (ReflectionException ex) {
          throw new SerializationException(
              "Error accessing field: " + field.getName() + " (" + type.getName() + ")", ex);
        } catch (SerializationException ex) {
          ex.addTrace(field + " (" + type.getName() + ")");
          throw ex;
        } catch (Exception runtimeEx) {
          SerializationException ex = new SerializationException(runtimeEx);
          ex.addTrace(field + " (" + type.getName() + ")");
          throw ex;
        }
      }
}public void setDeprecated(Class type, String fieldName, boolean deprecated) {
    FieldMetadata metadata = getFields(type).get(fieldName);
