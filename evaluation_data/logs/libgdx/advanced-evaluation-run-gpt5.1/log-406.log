public String get(String key) {
    String result = properties.get(key);
    if (result == null) {
      if (parent != null) result = parent.get(key);
      if (result == null) {
        if (exceptionOnMissingKey)
          throw new MissingResourceException(
              "Can't find bundle key " + key, this.getClass().getName(), key);
        else return "???" + key + "???";
      }
    }
    return result;
}
@Nullable
  public <T> AssetLoader getLoader(final Class<T> type, @Nullable final String fileName) {
    ObjectMap<String, AssetLoader> loaders = this.loaders.get(type);
    if (loaders == null || loaders.size < 1) return null;
    if (fileName == null) return loaders.get("");
    AssetLoader result = null;
    int length = -1;
    for (Entry<String, AssetLoader> entry : loaders.entries()) {
      if (entry.key.length() > length && fileName.endsWith(entry.key)) {
        result = entry.value;
        length = entry.key.length();
