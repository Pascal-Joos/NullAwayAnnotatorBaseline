class com.badlogic.gdx.scenes.scene2d.ui.ProgressBar {
public ProgressBar(float min, float max, float stepSize, boolean vertical, Skin skin) {
    this(
        min,
        max,
        stepSize,
        vertical,
        skin.get("default-" + (vertical ? "vertical" : "horizontal"), ProgressBarStyle.class));
}public boolean setValue(float value) {
    value = clamp(round(value));
    float oldValue = this.value;
    if (value == oldValue) return false;
    float oldVisualValue = getVisualValue();
    this.value = value;

    if (programmaticChangeEvents) {
      ChangeEvent changeEvent = Pools.obtain(ChangeEvent.class);
      boolean cancelled = fire(changeEvent);
      Pools.free(changeEvent);
      if (cancelled) {
        this.value = oldValue;
        return false;
      }
    }

    if (animateDuration > 0) {
      animateFromValue = oldVisualValue;
      animateTime = animateDuration;
    }
    return true;
}public ProgressBar(
      float min, float max, float stepSize, boolean vertical, Skin skin, String styleName) {
    this(min, max, stepSize, vertical, skin.get(styleName, ProgressBarStyle.class));
}
}
