}public void toJson(
      @Null Object object,
      @Nullable @Null Class knownType,
      @Nullable @Null Class elementType,
      Writer writer) {
    setWriter(writer);
    try {
      writeValue(object, knownType, elementType);
    } finally {
      StreamUtils.closeQuietly(this.writer);
