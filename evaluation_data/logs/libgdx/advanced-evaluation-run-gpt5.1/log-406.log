            == null) // Get the enum type when an enum value is an inner class (enum A {b{}}).
        actualType = actualType.getSuperclass();
        if (typeName != null && (knownType == null || knownType != actualType)) {
          writeObjectStart(actualType, null);
          writer.name("value");
