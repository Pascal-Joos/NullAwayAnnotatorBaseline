}public boolean setScrollFocus(@Nullable @Null Actor actor) {
    if (scrollFocus == actor) return true;
    FocusEvent event = Pools.obtain(FocusEvent.class);
    event.setStage(this);
    event.setType(FocusEvent.Type.scroll);
