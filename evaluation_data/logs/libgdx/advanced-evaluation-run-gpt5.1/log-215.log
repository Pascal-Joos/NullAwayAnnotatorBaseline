    float scaleX = getScaleX();
    float scaleY = getScaleY();

    if (drawable instanceof TransformDrawable) {
      float rotation = getRotation();
      if (scaleX != 1 || scaleY != 1 || rotation != 0) {
        ((TransformDrawable) drawable)
            .draw(
                batch,
                x + imageX,
                y + imageY,
                getOriginX() - imageX,
                getOriginY() - imageY,
                imageWidth,
                imageHeight,
                scaleX,
                scaleY,
                rotation);
        return;
      }
    }
    if (drawable != null)
      drawable.draw(batch, x + imageX, y + imageY, imageWidth * scaleX, imageHeight * scaleY);
}public void setDrawable(@Nullable @Null Drawable drawable) {
    if (this.drawable == drawable) return;
    if (drawable != null) {
      if (getPrefWidth() != drawable.getMinWidth() || getPrefHeight() != drawable.getMinHeight())
        invalidateHierarchy();
    } else invalidateHierarchy();
    this.drawable = drawable;
}
