          imageResolver,
          tileSet,
          element,
          tileElements,
          name,
          firstgid,
          tilewidth,
          tileheight,
          spacing,
          margin,
          source,
          offsetX,
          offsetY,
          imageSource,
          imageWidth,
          imageHeight,
