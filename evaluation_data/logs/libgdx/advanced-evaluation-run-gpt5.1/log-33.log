          assetManager.unload(fileName);
          texture.glHandle = Gdx.gl.glGenTexture();
          assetManager.load(fileName, Texture.class, params);
        }
      }
      managedTextureArray.clear();
      managedTextureArray.addAll(textures);
    }
}

