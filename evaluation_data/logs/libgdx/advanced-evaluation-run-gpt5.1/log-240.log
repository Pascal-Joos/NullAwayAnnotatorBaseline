                          c.actorY = (float) Math.floor(c.actorY);
                        }
                  
                        if (c.actor != null) c.actor.setBounds(c.actorX, c.actorY, c.actorWidth, c.actorHeight);
                  
                        if (c.endRow) {
                          currentX = x;
                          currentY += rowHeight[c.row];
                        } else currentX += spannedCellWidth + c.computedPadRight;
                      }
                  
