                        int column = c.column, row = c.row;
                        Actor a = Nullability.castToNonnull(c.actor);
                  
                        float spannedWeightedWidth = 0;
                        int colspan = c.colspan;
                        for (int ii = column, nn = ii + colspan; ii < nn; ii++)
                          spannedWeightedWidth += columnWeightedWidth[ii];
                        float weightedHeight = rowWeightedHeight[row];
                  
                        float prefWidth = c.prefWidth.get(a), prefHeight = c.prefHeight.get(a);
                        float minWidth = Nullability.castToNonnull(c.minWidth).get(a), minHeight = Nullability.castToNonnull(c.minHeight).get(a);
                        Value maxWidthValue = c.getMaxWidthValue();
                        float maxWidth = maxWidthValue == null ? 0 : maxWidthValue.get(a);
