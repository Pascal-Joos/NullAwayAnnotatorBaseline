                    this,
                    event.getListenerActor(),
                    event.getTarget(),
                    event.getPointer(),
                    event.getButton());
          return true;
        case touchUp:
          if (event.isTouchFocusCancel()) {
            detector.reset();
            return false;
          }
          this.event = event;
          actor = event.getListenerActor();
          if (actor == null) return false;
          detector.touchUp(
