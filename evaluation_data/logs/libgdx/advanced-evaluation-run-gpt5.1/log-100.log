  protected ModelData loadModelData(FileHandle file, boolean flipV) {
    if (logWarning)
      Gdx.app.error(
          "ObjLoader",
          "Wavefront (OBJ) is not fully supported, consult the documentation for more information");
    String line;
    String[] tokens;
