          drawExpandIcon(node, expandIcon, batch, expandX, iconY);
        }
      } else if (actorY < cullBottom) //
      break;
      if (node.expanded && node.children.size > 0)
        drawIcons(batch, r, g, b, a, node, node.children, indent + indentSpacing, plusMinusWidth);
    }
    return actorY;
}
