        Actor a = c.actor;
        if (a == null) continue;

        float spannedWeightedWidth = 0;
        int colspan = c.colspan;
        for (int ii = column, nn = ii + colspan; ii < nn; ii++)
          spannedWeightedWidth += columnWeightedWidth[ii];
