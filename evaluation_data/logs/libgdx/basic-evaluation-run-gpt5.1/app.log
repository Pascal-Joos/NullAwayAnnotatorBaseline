      // Spacing between actors isn't additive, the larger is used. Also, no spacing around edges.
      c.computedPadLeft =
          c.padLeft.get(a) + (column == 0 ? 0 : Math.max(0, c.spaceLeft.get(a) - spaceRightLast));
      c.computedPadTop = c.padTop.get(a);
