      if (repeatCount > 0) executedCount++;
      if (executedCount == repeatCount) return true;
      if (action != null) action.restart();
    }
    return false;
  }

  /** Causes the action to not repeat again. */
  public void finish() {
    finished = true;
  }

  public void restart() {
    super.restart();
    executedCount = 0;
    finished = false;
  }

