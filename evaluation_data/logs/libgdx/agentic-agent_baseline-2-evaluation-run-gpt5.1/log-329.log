  /**
   * Indicates that subsequent cells should be added to a new row and returns 
the cell values that
   * will be used as the defaults for all cells in the new row.
   */
  @Nullable
  public Cell row() {
    if (cells.size > 0) {
      if (!implicitEndRow) {
        if (cells.peek().endRow) return rowDefaults; // Row was already ended.
        endRow();
      }
      invalidate();
    }
    implicitEndRow = false;
    if (rowDefaults != null) cellPool.free(rowDefaults);
    rowDefaults = obtainCell();
    rowDefaults.clear();
    return rowDefaults;
  }

  private void endRow() {
    Object[] cells = this.cells.items;
    int rowColumns = 0;
    for (int i = this.cells.size - 1; i >= 0; i--) {
      Cell cell = (Cell) cells[i];
      if (cell.endRow) break;
      rowColumns += cell.colspan;
    }
    columns = Math.max(columns, rowColumns);
    rows++;
    this.cells.peek().endRow = true;
  }

