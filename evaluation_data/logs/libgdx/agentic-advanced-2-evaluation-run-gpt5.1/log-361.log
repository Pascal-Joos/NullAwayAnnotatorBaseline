                ActorGestureListener.this.tap(event, tmpCoords.x, tmpCoords.y, count, button);
                return true;
              }

              public boolean longPress(float stageX, float stageY) {
                actor.stageToLocalCoordinates(tmpCoords.set(stageX, stageY));
