class com.badlogic.gdx.graphics.g3d.Environment {
public Environment add(BaseLight light) {
    if (light instanceof DirectionalLight) add((DirectionalLight) light);
    else if (light instanceof PointLight) {
      add((PointLight) light);
    } else if (light instanceof SpotLight) add((SpotLight) light);
    else throw new GdxRuntimeException("Unknown light type");
    return this;
}public Environment remove(BaseLight light) {
    if (light instanceof DirectionalLight) remove((DirectionalLight) light);
    else if (light instanceof PointLight) remove((PointLight) light);
    else if (light instanceof SpotLight) remove((SpotLight) light);
    else throw new GdxRuntimeException("Unknown light type");
    return this;
}
}
