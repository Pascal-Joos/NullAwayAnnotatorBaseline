            idx + dirLightsColorOffset,
            directionalLights[i].color.r,
            directionalLights[i].color.g,
            directionalLights[i].color.b);
        program.setUniformf(
            idx + dirLightsDirectionOffset,
            directionalLights[i].direction.x,
            directionalLights[i].direction.y,
