        finalVerts[vi++] = verts.get(vertIndex++);
        finalVerts[vi++] = verts.get(vertIndex);
        if (hasNorms) {
          int normIndex = faces.get(i++) * 3;
          finalVerts[vi++] = norms.get(normIndex++);
          finalVerts[vi++] = norms.get(normIndex++);
          finalVerts[vi++] = norms.get(normIndex);
        }
        if (hasUVs) {
