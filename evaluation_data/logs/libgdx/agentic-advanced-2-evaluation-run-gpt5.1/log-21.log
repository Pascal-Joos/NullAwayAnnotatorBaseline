}public void setColor(Color tint) {
    color.set(tint);
    float color = tint.toFloatBits();

    final float[] vertices = this.vertices;
    for (int i = 2; i < vertices.length; i += Sprite.VERTEX_SIZE) vertices[i] = color;
}
