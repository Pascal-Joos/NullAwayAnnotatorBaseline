    if (mergeTransform) {
      this.transform.mul(parentTransform ? node.globalTransform : 
node.localTransform);
      copy.translation.set(0, 0, 0);
      copy.rotation.idt();
      copy.scale.set(1, 1, 1);
    } else if (parentTransform && copy.hasParent())
      this.transform.mul(node.getParent().globalTransform);
