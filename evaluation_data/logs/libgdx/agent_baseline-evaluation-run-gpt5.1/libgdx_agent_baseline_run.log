  private abstract static class MapIterator<K, V, I> implements Iterable<I>, 
Iterator<I> {
    public boolean hasNext;

    final ObjectMap<K, V> map;
    int nextIndex, currentIndex;
    boolean valid = true;

    public MapIterator(ObjectMap<K, V> map) {
      this.map = map;
      reset();
    }

    public void reset() {
      currentIndex = -1;
      nextIndex = -1;
      findNextIndex();
    }

    void findNextIndex() {
      K[] keyTable = map.keyTable;
      for (int n = keyTable.length; ++nextIndex < n; ) {
        if (keyTable[nextIndex] != null) {
          hasNext = true;
          return;
        }
      }
      hasNext = false;
    }

    public void remove() {
      int i = currentIndex;
      if (i < 0) throw new IllegalStateException("next must be called before 
remove.");
      K[] keyTable = map.keyTable;
      V[] valueTable = map.valueTable;
      int mask = map.mask, next = i + 1 & mask;
      K key;
      while ((key = keyTable[next]) != null) {
        int placement = map.place(key);
        if ((next - placement & mask) > (i - placement & mask)) {
          keyTable[i] = key;
          valueTable[i] = valueTable[next];
          i = next;
        }
        next = next + 1 & mask;
      }
      keyTable[i] = null;
      valueTable[i] = null;
      map.size--;
      if (i != currentIndex) --nextIndex;
      currentIndex = -1;
    }
  }

