    29  /**
    30   * A node is part of a hierarchy of Nodes in a {@link Model}. A Node 
encodes a transform relative to
    31   * its parents. A Node can have child nodes. Optionally a node can 
specify a {@link MeshPart} and a
    32   * {@link Material} to be applied to the mesh part.
    33   *
    34   * @author badlogic
    35   */
    36  public class Node {
    37    /** the id, may be null, FIXME is this unique? * */
    38    @Nullable public String id;
    39  
    40    /**
    41     * Whether this node should inherit the transformation of its parent 
node, defaults to true. When
    42     * this flag is false the value of {@link #globalTransform} will be 
the same as the value of
    43     * {@link #localTransform} causing the transform to be independent of 
its parent transform.
    44     */
    45    public boolean inheritTransform = true;
    46  
    47    /**
    48     * Whether this node is currently being animated, if so the 
translation, rotation and scale values
    49     * are not used.
    50     */
    51    public boolean isAnimated;
    52  
    53    /** the translation, relative to the parent, not modified by 
animations * */
    54    public final Vector3 translation = new Vector3();
    55  
    56    /** the rotation, relative to the parent, not modified by animations *
*/
    57    public final Quaternion rotation = new Quaternion(0, 0, 0, 1);
    58  
    59    /** the scale, relative to the parent, not modified by animations * */
    60    public final Vector3 scale = new Vector3(1, 1, 1);
    61  
    62    /**
    63     * the local transform, based on translation/rotation/scale ({@link 
#calculateLocalTransform()})
    64     * or any applied animation *
    65     */
    66    public final Matrix4 localTransform = new Matrix4();
    67  
    68    /**
    69     * the global transform, product of local transform and transform of 
the parent node, calculated
    70     * via {@link #calculateWorldTransform()} *
    71     */
    72    public final Matrix4 globalTransform = new Matrix4();
    73  
    74    public Array<NodePart> parts = new Array<NodePart>(2);
    75  
    76    @Nullable protected Node parent;
    77    private final Array<Node> children = new Array<Node>(2);
    78  
    79    /**
    80     * Calculates the local transform based on the translation, scale and 
rotation
    81     *
    82     * @return the local transform
    83     */
    84    public Matrix4 calculateLocalTransform() {
    85      if (!isAnimated) localTransform.set(translation, rotation, scale);
    86      return localTransform;
    87    }
    88  
    89    /**
    90     * Calculates the world transform; the product of local transform and 
the parent's world
    91     * transform.
    92     *
    93     * @return the world transform
    94     */
    95    public Matrix4 calculateWorldTransform() {
    96      if (inheritTransform && parent != null)
    97        globalTransform.set(parent.globalTransform).mul(localTransform);
    98      else globalTransform.set(localTransform);
    99      return globalTransform;
   100    }
   101  
   102    /**
   103     * Calculates the local and world transform of this node and 
optionally all its children.
   104     *
   105     * @param recursive whether to calculate the local/world transforms 
for children.
   106     */
   107    public void calculateTransforms(boolean recursive) {
   108      calculateLocalTransform();
   109      calculateWorldTransform();
   110  
   111      if (recursive) {
   112        for (Node child : children) {
   113          child.calculateTransforms(true);
   114        }
   115      }
   116    }
