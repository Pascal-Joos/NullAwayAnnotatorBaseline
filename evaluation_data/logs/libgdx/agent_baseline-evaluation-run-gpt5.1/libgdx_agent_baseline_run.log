    78    public ParticleController() {
    79      transform = new Matrix4();
    80      scale = new Vector3(1, 1, 1);
    81      influencers = new Array<Influencer>(true, 3, Influencer.class);
    82      setTimeStep(DEFAULT_TIME_STEP);
