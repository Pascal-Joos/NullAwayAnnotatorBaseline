   166    public BoundingBox extendBoundingBox(final BoundingBox out, boolean 
transform) {
   167      final int partCount = parts.size;
   168      for (int i = 0; i < partCount; i++) {
   169        final NodePart part = parts.get(i);
   170        if (part.enabled) {
   171          final MeshPart meshPart = part.meshPart;
   172          if (transform)
   173            meshPart.mesh.extendBoundingBox(out, meshPart.offset, 
meshPart.size, globalTransform);
   174          else meshPart.mesh.extendBoundingBox(out, meshPart.offset, 
meshPart.size);
   175        }
   176      }
   177      final int childCount = children.size;
   178      for (int i = 0; i < childCount; i++) 
children.get(i).extendBoundingBox(out);
   179      return out;
