    renderData.rotationChannel =
        controller.particles.addChannel(ParticleChannels.Rotation2D, 
Rotation2dInitializer.get());
  }

  @Override
  public boolean isCompatible(@Nullable ParticleBatch<?> batch) {
    return batch instanceof PointSpriteParticleBatch;
  }

  @Override
  public ParticleControllerComponent copy() {
    return new PointSpriteRenderer(batch);
  }
}
