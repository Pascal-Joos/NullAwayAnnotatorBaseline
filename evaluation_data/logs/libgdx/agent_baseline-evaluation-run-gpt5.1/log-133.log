  public static class BrownianAcceleration extends Strength {
    @Nullable FloatChannel accelerationChannel;

    public BrownianAcceleration() {}

    public BrownianAcceleration(BrownianAcceleration rotation) {
      super(rotation);
    }

    @Override
    public void allocateChannels() {
      super.allocateChannels();
      accelerationChannel = 
controller.particles.addChannel(ParticleChannels.Acceleration);
    }

    @SuppressWarnings("NullAway")
    private FloatChannel requireAccelerationChannel() {
      if (accelerationChannel == null) {
        throw new IllegalStateException("Acceleration channel not allocated");
      }
      return accelerationChannel;
    }

    @Override
    public void update() {
      final FloatChannel nonNullAccelerationChannel = 
requireAccelerationChannel();
      int lifeOffset = ParticleChannels.LifePercentOffset, strengthOffset = 0, 
forceOffset = 0;
      for (int i = 0, c = controller.particles.size;
          i < c;
          ++i, strengthOffset += strengthChannel.strideSize,
              forceOffset += nonNullAccelerationChannel.strideSize, lifeOffset 
+= lifeChannel.strideSize) {

        float strength =
            strengthChannel.data[strengthOffset + 
ParticleChannels.VelocityStrengthStartOffset]
                + strengthChannel.data[strengthOffset + 
ParticleChannels.VelocityStrengthDiffOffset]
                    * strengthValue.getScale(lifeChannel.data[lifeOffset]);
        TMP_V3
            .set(MathUtils.random(-1, 1f), MathUtils.random(-1, 1f), 
MathUtils.random(-1, 1f))
            .nor()
            .scl(strength);
        nonNullAccelerationChannel.data[forceOffset + ParticleChannels.XOffset] 
+= TMP_V3.x;
        nonNullAccelerationChannel.data[forceOffset + ParticleChannels.YOffset] 
+= TMP_V3.y;
        nonNullAccelerationChannel.data[forceOffset + ParticleChannels.ZOffset] 
+= TMP_V3.z;
      }
    }

    @Override
    public BrownianAcceleration copy() {
      return new BrownianAcceleration(this);
    }
  }

