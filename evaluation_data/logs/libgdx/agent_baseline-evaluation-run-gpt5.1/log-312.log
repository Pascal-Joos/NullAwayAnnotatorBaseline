    clearChildren();
    padTop = backgroundTop;
    padLeft = backgroundLeft;
    padBottom = backgroundBottom;
    padRight = backgroundRight;
    align = Align.center;
    debug(Debug.none);
    cellDefaults.reset();
    for (int i = 0, n = columnDefaults.size; i < n; i++) {
