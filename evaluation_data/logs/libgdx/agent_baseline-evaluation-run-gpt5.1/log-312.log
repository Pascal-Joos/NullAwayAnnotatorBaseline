      c.computedPadRight = c.padRight.get(a) + ((column + colspan) == columns ? 
0 : spaceRight);
      c.computedPadBottom = c.padBottom.get(a) + (row == rows - 1 ? 0 : 
c.spaceBottom.get(a));
