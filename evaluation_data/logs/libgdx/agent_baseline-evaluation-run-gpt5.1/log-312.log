          batch.flush();
          clipEnd();
        }
      } else drawChildren(batch, parentAlpha);
      resetTransform(batch);
    } else {
      drawBackground(batch, parentAlpha, getX(), getY());
      super.draw(batch, parentAlpha);
    }
  }

