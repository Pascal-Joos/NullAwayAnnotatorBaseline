package com.badlogic.gdx.graphics.g3d.model;

import com.badlogic.gdx.graphics.g3d.Model;
import com.badlogic.gdx.graphics.g3d.model.data.ModelNode;
import com.badlogic.gdx.graphics.g3d.model.data.ModelNodePart;
import com.badlogic.gdx.math.Matrix4;
import com.badlogic.gdx.math.Quaternion;
import com.badlogic.gdx.math.Vector3;
import com.badlogic.gdx.utils.Array;
import javax.annotation.Nullable;

/** A node in a {@link Model}. A node has a transform and optionally a graphical
{@link NodePart}. */
public class Node implements NodeRenderable {

  /** the id of this node, may be null. */
  @Nullable public String id;

  /** the parent of this node, or null if this is a root node. */
  @Nullable public Node parent;

  /** the children of this node */
  public final Array<Node> children = new Array<Node>();

  /** the parts of this node, usually only one */
  public final Array<NodePart> parts = new Array<NodePart>();

  /** whether this node is animated */
  public boolean isAnimated;

  /** whether this node inherits the transform of its parent */
  public boolean inheritTransform = true;

  /** the translation of this node relative to its parent */
  public final Vector3 translation = new Vector3();

  /** the rotation of this node relative to its parent */
  public final Quaternion rotation = new Quaternion();

  /** the scale of this node relative to its parent */
  public final Vector3 scale = new Vector3(1, 1, 1);

  /** the local transform of this node, calculated from translation, rotation 
and scale. */
  public final Matrix4 localTransform = new Matrix4();

  /** the global transform of this node, calculated from the local transform and
the parent transform. */
  public final Matrix4 globalTransform = new Matrix4();

  /** whether the local transform needs to be recalculated */
  public boolean calculateLocalTransform = true;

  /** whether the global transform needs to be recalculated */
  public boolean calculateTransforms = true;

  public Node() {}

  public Node(@Nullable String id) {
    this.id = id;
  }

  public Node(ModelNode node, Array<NodePart> modelNodeParts) {
    this.id = node.id;
    if (node.translation != null) this.translation.set(node.translation);
    if (node.rotation != null) this.rotation.set(node.rotation);
    if (node.scale != null) this.scale.set(node.scale);
    this.inheritTransform = node.inheritTransform;

    if (node.parts != null) {
      for (ModelNodePart modelNodePart : node.parts) {
        NodePart nodePart = new NodePart();
        nodePart.meshPart = modelNodePart.meshPart;
        nodePart.material = modelNodePart.material;
        nodePart.enabled = modelNodePart.enabled;
        this.parts.add(nodePart);
        modelNodeParts.add(nodePart);
      }
    }

    if (node.children != null) {
      for (ModelNode child : node.children) {
        addChild(new Node(child, modelNodeParts));
      }
    }
  }

  public void calculateLocalTransform() {
    if (!calculateLocalTransform) return;
    localTransform.set(translation, rotation, scale);
    calculateLocalTransform = false;
  }

  public void calculateWorldTransform() {
    calculateLocalTransform();
    if (inheritTransform && parent != null) {
      globalTransform.set(parent.globalTransform).mul(localTransform);
    } else {
      globalTransform.set(localTransform);
    }
    calculateTransforms = false;
  }

  public void calculateTransforms(boolean recursive) {
    calculateLocalTransform();
    calculateWorldTransform();
    if (recursive) {
      for (Node child : children) {
        child.calculateTransforms(true);
      }
    }
  }

  public void updateTransforms(boolean recursive) {
    if (calculateTransforms) calculateTransforms(recursive);
  }

  public void resetTransform(boolean recursive) {
    translation.set(0, 0, 0);
    rotation.idt();
    scale.set(1, 1, 1);
    localTransform.idt();
    globalTransform.idt();
    calculateTransforms = true;
    calculateLocalTransform = false;
    if (recursive) {
      for (Node child : children) {
        child.resetTransform(true);
      }
    }
  }

  public void setTranslation(float x, float y, float z) {
    translation.set(x, y, z);
    calculateLocalTransform = true;
    calculateTransforms = true;
  }

  public void setTranslation(Vector3 translation) {
    this.translation.set(translation);
    calculateLocalTransform = true;
    calculateTransforms = true;
  }

  public void setRotation(Quaternion rotation) {
    this.rotation.set(rotation);
    calculateLocalTransform = true;
    calculateTransforms = true;
  }

  public void setRotation(float x, float y, float z, float w) {
    this.rotation.set(x, y, z, w);
    calculateLocalTransform = true;
    calculateTransforms = true;
  }

  public void setScale(float scale) {
    this.scale.set(scale, scale, scale);
    calculateLocalTransform = true;
    calculateTransforms = true;
  }

  public void setScale(float x, float y, float z) {
    this.scale.set(x, y, z);
    calculateLocalTransform = true;
    calculateTransforms = true;
  }

  public void setScale(Vector3 scale) {
    this.scale.set(scale);
    calculateLocalTransform = true;
    calculateTransforms = true;
  }

  public void setTransform(Matrix4 transform) {
    transform.getTranslation(translation);
    transform.getRotation(rotation, true);
    transform.getScale(scale);
    localTransform.set(transform);
    calculateLocalTransform = false;
    calculateTransforms = true;
  }

  public void setLocalTransform(Matrix4 transform) {
    localTransform.set(transform);
    calculateLocalTransform = false;
    calculateTransforms = true;
  }

  public void setGlobalTransform(Matrix4 transform) {
    globalTransform.set(transform);
    if (parent != null && inheritTransform) {
      parent.globalTransform.inv().mul(transform).getTranslation(translation);
      transform.getRotation(rotation, true);
      transform.getScale(scale);
    } else {
      transform.getTranslation(translation);
      transform.getRotation(rotation, true);
      transform.getScale(scale);
    }
    calculateLocalTransform = true;
    calculateTransforms = false;
  }

  public void attachTo(@Nullable Node parent) {
    if (this.parent == parent) return;
    if (this.parent != null) this.parent.removeChild(this);
    if (parent != null) parent.addChild(this);
  }

  public void detach() {
    if (parent != null) parent.removeChild(this);
  }

  public void addChild(Node child) {
    if (child.parent != null) child.parent.removeChild(child);
    child.parent = this;
    children.add(child);
  }

  public void removeChild(Node child) {
    if (children.removeValue(child, true)) {
      child.parent = null;
    }
  }

  public Array<Node> getChildren() {
    return children;
  }

  public Array<NodePart> getParts() {
    return parts;
  }

  @Override
  public void getRenderables(Array<com.badlogic.gdx.graphics.g3d.Renderable> 
renderables, 
com.badlogic.gdx.utils.Pool<com.badlogic.gdx.graphics.g3d.Renderable> pool) {
    for (NodePart part : parts) {
      if (part.enabled) {
        com.badlogic.gdx.graphics.g3d.Renderable renderable = pool.obtain();
        renderable.material = part.material;
        renderable.meshPart.set(part.meshPart);
        renderable.worldTransform.set(globalTransform);
        renderables.add(renderable);
      }
    }
    for (Node child : children) {
      child.getRenderables(renderables, pool);
    }
  }

  /**
   * <p>Override this method in your custom Node class to copy any additional 
fields you've added.
   *
   * @return This Node for chaining
   */
  protected Node set(Node other) {
    detach();
    id = other.id;
    isAnimated = other.isAnimated;
    inheritTransform = other.inheritTransform;
    translation.set(other.translation);
    rotation.set(other.rotation);
    scale.set(other.scale);
    localTransform.set(other.localTransform);
    globalTransform.set(other.globalTransform);
    parts.clear();
    for (NodePart nodePart : other.parts) {
      parts.add(nodePart.copy());
    }
    children.clear();
    for (Node child : other.getChildren()) {
      addChild(child.copy());
    }
    return this;
  }

  /**
   * Helper method to recursive fetch a node from an array
   *
   * @param recursive false to fetch a root node only, true to search the entire
node tree for the
   *     specified node.
   * @return The node with the specified id, or null if not found.
   */
  @Nullable
  public static Node getNode(
      final Array<Node> nodes, @Nullable final String id, boolean recursive, 
boolean ignoreCase) {
    final int n = nodes.size;
    Node node;
    if (ignoreCase) {
      for (int i = 0; i < n; i++)
        if ((node = nodes.get(i)).id != null && node.id.equalsIgnoreCase(id)) 
return node;
    } else {
      for (int i = 0; i < n; i++) if ((node = nodes.get(i)).id != null && 
node.id.equals(id)) return node;
    }
    if (recursive) {
      for (int i = 0; i < n; i++)
        if ((node = getNode(nodes.get(i).children, id, true, ignoreCase)) != 
null) return node;
    }
    return null;
  }
}
EOF
