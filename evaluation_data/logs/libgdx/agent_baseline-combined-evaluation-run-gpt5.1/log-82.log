/** A ModelInstance represents a copy of a {@link Model}. Multiple instances can
be created from the same Model, all sharing the
 * meshes and materials of the Model. A ModelInstance has a transform and a list
of nodes. A ModelInstance can be rendered by a
 * {@link ModelBatch}. */
public class ModelInstance implements RenderableProvider, Poolable {
        public Model model;
        public final Array<Node> nodes = new Array<Node>();
        public final Array<Material> materials = new Array<Material>();
        public final Matrix4 transform = new Matrix4();
        public Object userData;
        public boolean calculateTransforms = true;
        public boolean defaultShareKeyframes = true;

        public ModelInstance () {
        }

        public ModelInstance (final Model model) {
                this(model, (Matrix4)null);
        }

        public ModelInstance (final Model model, @Nullable final Matrix4 
transform) {
                this(model, transform, (Array<String>)null);
        }

        public ModelInstance (final Model model, @Nullable final Matrix4 
transform, @Nullable final Array<String> rootNodeIds) {
                this(model, transform, rootNodeIds, true);
        }

        public ModelInstance (final Model model, @Nullable final Matrix4 
transform, @Nullable final Array<String> rootNodeIds,
                boolean shareKeyframes) {
                this.model = model;
                this.transform.set(transform == null ? Matrix4.Identity : 
transform);
                copyNodes(model.nodes, rootNodeIds);
                copyAnimations(model.animations, shareKeyframes);
                calculateTransforms();
        }

        /** Constructs a new ModelInstance at the specified position. */
        public ModelInstance (final Model model, Vector3 position) {
                this(model);
                this.transform.setToTranslation(position);
        }

        /** Constructs a new ModelInstance at the specified position. */
        public ModelInstance (final Model model, float x, float y, float z) {
                this(model);
                this.transform.setToTranslation(x, y, z);
        }

        /** Constructs a new ModelInstance with the specified transform. */
        public ModelInstance (final Model model, Matrix4 transform) {
                this(model, transform, (Array<String>)null);
        }

        /** Constructs a new ModelInstance which is an copy of the specified 
ModelInstance. */
        public ModelInstance (ModelInstance copyFrom) {
                this(copyFrom, copyFrom.transform.cpy());
        }

        /** Constructs a new ModelInstance which is an copy of the specified 
ModelInstance. */
        public ModelInstance (ModelInstance copyFrom, final Matrix4 transform) {
                this(copyFrom, transform, copyFrom.defaultShareKeyframes);
        }

        /** Constructs a new ModelInstance which is an copy of the specified 
ModelInstance. */
        public ModelInstance (ModelInstance copyFrom, final Matrix4 transform, 
boolean shareKeyframes) {
                this.model = copyFrom.model;
                this.transform.set(transform == null ? Matrix4.Identity : 
transform);
                copyNodes(copyFrom.nodes, null);
                copyAnimations(copyFrom.animations, shareKeyframes);
                calculateTransforms();
        }

        private void copyNodes (Iterable<Node> source, @Nullable Array<String> 
nodeIds) {
                ObjectMap<Node, Node> mapping = new ObjectMap<Node, Node>();
                for (Node node : source) {
                        if (nodeIds == null || nodeIds.contains(node.id, false))
{
                                Node copy = node.copy();
                                nodes.add(copy);
                                mapping.put(node, copy);
                        }
                }
                // fix bone references
                for (Node node : nodes) {
                        for (NodePart part : node.parts) {
                                if (part.invBoneBindTransforms != null) {
                                        ArrayMap<Node, Matrix4> newMap = new 
ArrayMap<Node, Matrix4>(true, part.invBoneBindTransforms.size);
                                        for (int i = 0; i < 
part.invBoneBindTransforms.size; i++) {
                                                Node orig = 
part.invBoneBindTransforms.keys[i];
                                                Node mapped = mapping.get(orig);
                                                if (mapped != null) 
newMap.put(mapped, part.invBoneBindTransforms.values[i]);
                                        }
                                        part.invBoneBindTransforms = newMap;
                                }
                        }
                }
        }

        /** Copy source animations to this ModelInstance
         *
         * @param source Iterable collection of source animations {@link 
Animation}
         * @param shareKeyframes Shallow copy of {@link NodeKeyframe}'s if it's 
true, otherwise make a
         *     deep copy.
         */
        public void copyAnimations (final Iterable<Animation> source, boolean 
shareKeyframes) {
                for (final Animation anim : source) {
                        copyAnimation(anim, shareKeyframes);
                }
        }

        /** Copy the source animation to this ModelInstance
         *
         * @param sourceAnim The source animation {@link Animation}
         */
        public void copyAnimation (Animation sourceAnim) {
                copyAnimation(sourceAnim, defaultShareKeyframes);
        }

        /** Copy the source animation to this ModelInstance
