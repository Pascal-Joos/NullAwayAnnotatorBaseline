splits: " + name);
        NinePatch patch = new NinePatch(region, splits[0], splits[1], splits[2],
splits[3]);
        int[] pads = region.findValue("pad");
        if (pads != null) patch.setPadding(pads[0], pads[1], pads[2], pads[3]);
        return patch;
      }
    }
    return null;
  }

