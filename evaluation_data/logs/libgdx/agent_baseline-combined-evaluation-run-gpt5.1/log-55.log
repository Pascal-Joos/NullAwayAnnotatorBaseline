  @Nullable
  public @Null NinePatch createPatch(String name) {
    for (int i = 0, n = regions.size; i < n; i++) {
      AtlasRegion region = regions.get(i);
      if (region.name.equals(name)) {
        int[] splits = region.findValue("split");
        if (splits == null)
