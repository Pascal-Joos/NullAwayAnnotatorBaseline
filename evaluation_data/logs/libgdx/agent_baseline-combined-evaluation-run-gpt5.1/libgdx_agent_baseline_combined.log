                                }
                                if (nanim.scaling != null) {
                                        nodeAnim.scaling = new 
Array<NodeKeyframe<Vector3>>();
                                        for (final NodeKeyframe<Vector3> kf : 
nanim.scaling)
                                                nodeAnim.scaling.add(new 
NodeKeyframe<Vector3>(kf.keytime, kf.value));
                                }
                        }
                        animation.nodeAnimations.add(nodeAnim);
                }
                animations.add(animation);
        }

