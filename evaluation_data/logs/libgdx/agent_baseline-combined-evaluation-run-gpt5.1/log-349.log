  public void setDeadzone(float deadzoneRadius) {
    if (deadzoneRadius < 0) throw new IllegalArgumentException("deadzoneRadius 
must be > 0");
    this.deadzoneRadius = deadzoneRadius;
    invalidate();
  }

  /**
   * Returns the x-position of the knob relative to the center of the widget. 
The positive direction
   * is right.
   */
  public float getKnobX() {
    return knobPosition.x;
  }

  /**
