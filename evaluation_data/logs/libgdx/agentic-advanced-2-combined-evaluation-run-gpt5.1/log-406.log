    if (newText.equals(oldText)) return false;
    text = newText;
    ChangeEvent changeEvent = Pools.obtain(ChangeEvent.class);
    boolean cancelled = fire(changeEvent);
    if (cancelled) text = oldText;
    Pools.free(changeEvent);
    return !cancelled;
}
