      if (result == null) {
        if (exceptionOnMissingKey)
          throw new MissingResourceException(
              "Can't find bundle key " + key, this.getClass().getName(), key);
        else return "???" + key + "???";
      }
    }
    return result;
}public String format(String key, Object... args) {
    return formatter.format(get(key), args);
}
}
