            public void parse(Region region) {
              region.left = Integer.parseInt(entry[1]);
              region.top = Integer.parseInt(entry[2]);
              region.width = Integer.parseInt(entry[3]);
              region.height = Integer.parseInt(entry[4]);
            }
          });
      regionFields.put(
