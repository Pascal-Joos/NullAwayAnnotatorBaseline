        throw new GdxRuntimeException("Model version not supported");

      model.id = Nullability.castToNonnull(json).getString("id", "");
      parseMeshes(model, Nullability.castToNonnull(json));
      parseMaterials(model, Nullability.castToNonnull(json), handle.parent().path());
      parseNodes(model, Nullability.castToNonnull(json));
      parseAnimations(model, Nullability.castToNonnull(json));
      return model;
  }
