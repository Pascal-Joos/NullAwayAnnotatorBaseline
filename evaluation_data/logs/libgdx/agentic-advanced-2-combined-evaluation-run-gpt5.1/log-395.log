                    String string = jsonData.asString();
                    if (type == null || type == String.class) return (T) string;
                    try {
                      if (type == int.class || type == Integer.class) return (T) Integer.valueOf(Nullability.castToNonnull(string));
                      if (type == float.class || type == Float.class) return (T) Float.valueOf(Nullability.castToNonnull(string));
                      if (type == long.class || type == Long.class) return (T) Long.valueOf(Nullability.castToNonnull(string));
                      if (type == double.class || type == Double.class) return (T) Double.valueOf(Nullability.castToNonnull(string));
                      if (type == short.class || type == Short.class) return (T) Short.valueOf(Nullability.castToNonnull(string));
                      if (type == byte.class || type == Byte.class) return (T) Byte.valueOf(Nullability.castToNonnull(string));
                    } catch (NumberFormatException ignored) {
                    }
                    if (type == boolean.class || type == Boolean.class) return (T) Boolean.valueOf(Nullability.castToNonnull(string));
                    if (type == char.class || type == Character.class) return (T) (Character) Nullability.castToNonnull(string).charAt(0);
                    if (ClassReflection.isAssignableFrom(Enum.class, type)) {
                      Enum[] constants = (Enum[]) type.getEnumConstants();
                      for (int i = 0, n = constants.length; i < n; i++) {
