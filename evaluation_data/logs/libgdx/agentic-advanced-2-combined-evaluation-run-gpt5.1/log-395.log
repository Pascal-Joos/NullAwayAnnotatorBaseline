                  if (jsonData.isBoolean()) {
                    try {
                      if (type == null || type == boolean.class || type == Boolean.class)
                        return (T) (Boolean) jsonData.asBoolean();
                    } catch (NumberFormatException ignored) {
                    }
                    jsonData = new JsonValue(jsonData.asString());
