      JsonValue object, StringBuilder buffer, int indent, PrettyPrintSettings settings) {
    OutputType outputType = settings.outputType;
    if (object.isObject()) {
      if (object.child == null) buffer.append("{}");
      else {
        boolean newLines = !isFlat(object);
