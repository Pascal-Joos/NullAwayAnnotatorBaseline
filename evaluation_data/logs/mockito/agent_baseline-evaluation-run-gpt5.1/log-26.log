            @Override
            public MethodHandles.Lookup getLookup() {
              throw new IllegalStateException("Dispatcher not initialized", t);
            }

            @Override
            public Object getModule(Class<?> type) {
              throw new IllegalStateException("Dispatcher not initialized", t);
            }

