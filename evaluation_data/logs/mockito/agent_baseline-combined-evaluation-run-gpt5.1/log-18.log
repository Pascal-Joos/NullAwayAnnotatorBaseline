    this.registeredInvocations = createRegisteredInvocations(mockSettings);
    this.mockStrictness = mockSettings.isLenient() ? Strictness.LENIENT : null;
    this.doAnswerStyleStubbing = new DoAnswerStyleStubbing();
  }

