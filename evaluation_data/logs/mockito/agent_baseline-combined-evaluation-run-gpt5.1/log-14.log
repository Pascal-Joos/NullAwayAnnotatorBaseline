  private static final String SMART_NULL_POINTER_EXCEPTION_MESSAGE =
      "You have a NullPointerException here:\n"
          + "-> at %s\n"
          + "because this method call was *not* stubbed correctly:\n"
          + "-> at %s\n"
          + "%s";

  private Reporter() {}

  public static MockitoException notAMockPassedToVerify(Class<?> type) {
    return new NotAMockException(String.format(NOT_A_MOCK_PASSED_TO_VERIFY, 
type.getSimpleName()));
  }

  public static MockitoException nullPassedToVerify() {
    return new NullInsteadOfMockException(NULL_PASSED_TO_VERIFY);
  }

  public static MockitoException notAMockPassedToWhenMethod() {
    return new NotAMockException(NOT_A_MOCK);
  }

  public static MockitoException nullPassedToWhenMethod() {
    return new NullInsteadOfMockException(NULL_WAS_PASSED_INSIDE_WHEN);
  }

  public static MockitoException missingMethodInvocation() {
    return new MissingMethodInvocationException(
        join(
            "when() requires an argument which has to be 'a method call on a 
mock'.",
            "For example:",
            "    when(mock.getArticles()).thenReturn(articles);",
            "Or 'a static method call on a prepared mock', for example:",
            "    prepareForTest(StaticService.class);",
            "    when(StaticService.className()).thenReturn(\"mocked\");",
            "Also, this error might show up because:",
            "1. you stub either of: final/private/equals()/hashCode() methods.",
            "   Those methods *cannot* be stubbed/verified.",
            "2. inside when() you don't call method on mock but on some other 
object."));

  }

  public static MockitoException unfinishedStubbing() {
    return new UnfinishedStubbingException();
  }

  public static MockitoException unfinishedVerificationException(Location 
location) {
    return new UnfinishedVerificationException(
        join(
            "Missing method call for verify(mock) here:",
            location,
            "Example of correct verification:",
            "    verify(mock).doSomething()",
            "Also, this error might show up because you verify either of: 
final/private/equals()/hashCode() methods.",
            "Those methods *cannot* be stubbed/verified."));
  }

  public static MockitoException invalidUseOfMatchers(
      int expectedMatchersCount, List<LocalizedMatcher> recordedMatchers) {
    return new InvalidUseOfMatchersException(
        join(
            "Invalid use of argument matchers!",
            expectedMatchersCount + " matchers expected, " + 
recordedMatchers.size() + " recorded:",
            localizedMatchersToString(recordedMatchers),
            "This exception may occur if matchers are combined with raw 
values:",
            "    //incorrect:",
            "    someMethod(anyObject(), \"raw String\");",
            "When using matchers, all arguments have to be provided by 
matchers.",
            "For example:",
            "    //correct:",
            "    someMethod(anyObject(), eq(\"String by matcher\"));",
            "For more info see javadoc for Matchers class."));
  }

  private static String localizedMatchersToString(List<LocalizedMatcher> 
matchers) {
    StringBuilder out = new StringBuilder();
    for (LocalizedMatcher m : matchers) {
      out.append("\n    ");
      out.append(m.toString());
    }
    return out.toString();
  }

  public static MockitoException smartNullPointerException(
      Location location, String invocation, String smartNullInfo) {
    return new SmartNullPointerException(
        String.format(
            SMART_NULL_POINTER_EXCEPTION_MESSAGE, location, invocation, 
smartNullInfo));
  }

  public static MockitoException wrongTypeOfReturnValue(
      String expectedType, String actualType, String methodName) {
    return new WrongTypeOfReturnValue(
        join(
            "Wrong return type in stubbed method",
            "Expected: " + expectedType,
            "Actual: " + actualType,
            "Method: " + methodName,
            "Please check the type of the returned value and the signature of 
the stubbed method."));
  }

  public static MockitoException cannotStubVoidMethodWithAReturnValue(String 
methodName) {
    return new CannotStubVoidMethodWithReturnValue(
        join(
            "Cannot stub a void method with a return value!",
            "Void methods cannot be stubbed with a return value.",
            "Instead, use doReturn() or doThrow() for stubbing.",
            "Example:",
            "    doReturn(value).when(mock).someVoidMethod();",
            "Method: " + methodName));
  }

  public static MockitoException moreThanOneAnswerReturned() {
    return new MockitoException(
        "More than one Answer returned. Please use thenReturn() or thenThrow() 
only once.");
  }

  public static MockitoException incorrectUseOfApi() {
    return new MockitoException(
        join(
            "Incorrect use of API detected.",
            "You probably misused some of the Mockito API.",
            "Please refer to the documentation for correct usage."));
  }

  public static MockitoException argumentsAreDifferent(
      String wanted, String actual, Location location) {
    return new ArgumentsAreDifferent(
        join(
            "Argument(s) are different! Wanted:",
            wanted,
            "Actual invocation has different arguments:",
            actual,
            location));
  }

  public static MockitoException wantedButNotInvoked(DescribedInvocation wanted)
{
    return new TooLittleActualInvocations(
        join(
            "Wanted but not invoked:",
            wanted.toString(),
            "However, there were other interactions with this mock."));
  }

  public static MockitoException wantedButNotInvokedInOrder(DescribedInvocation 
wanted) {
    return new VerificationInOrderFailure(
        join(
            "Verification in order failure:",
            "Wanted but not invoked:",
            wanted.toString(),
            "However, there were other interactions with this mock in order."));
  }

  public static MockitoException tooManyActualInvocations(
      int wantedCount, int actualCount, DescribedInvocation wanted, Location 
firstUndesired) {
    return new TooManyActualInvocations(
        join(
            "Wanted " + wantedCount + " times but was " + actualCount + " 
times.",
            "Wanted:",
            wanted.toString(),
            "First undesired invocation:",
            firstUndesired));
  }

  public static MockitoException neverWantedButInvoked(DescribedInvocation 
wanted, Location firstUndesired) {
    return new NeverWantedButInvoked(
        join(
            "Never wanted here:",
            wanted.toString(),
            "But invoked here:",
            firstUndesired));
  }

  public static MockitoException tooLittleActualInvocations(
      Discrepancy discrepancy, DescribedInvocation wanted, Location 
lastActualLocation) {
    return new TooLittleActualInvocations(
        join(
            "Too few invocations:",
            wanted.toString(),
            "Wanted " + discrepancy.getPluralizedWantedCount() + " but was " + 
discrepancy.getActualCount() + ".",
            "Last actual invocation:",
            lastActualLocation));
  }

  public static MockitoException tooLittleActualInvocationsInOrder(
      Discrepancy discrepancy, DescribedInvocation wanted, Location 
lastActualLocation) {
    return new VerificationInOrderFailure(
        join(
            "Verification in order failure:",
            "Too few invocations:",
            wanted.toString(),
            "Wanted " + discrepancy.getPluralizedWantedCount() + " but was " + 
discrepancy.getActualCount() + ".",
            "Last actual invocation:",
            lastActualLocation));
  }

  private static String createAllLocationsMessage(List<Location> locations) {
    StringBuilder sb = new StringBuilder();
    for (Location loc : locations) {
      sb.append("\n  at ").append(loc);
    }
    return sb.toString();
  }

  private static String createTooFewInvocationsMessage(
      Discrepancy discrepancy, DescribedInvocation wanted, List<Location> 
locations) {
    return join(
        wanted.toString(),
        "Wanted "
            + discrepancy.getPluralizedWantedCount()
            + (discrepancy.getWantedCount() == 0 ? "." : ":"),
        new LocationImpl(),
        "But was "
            + discrepancy.getPluralizedActualCount()
            + (discrepancy.getActualCount() == 0 ? "." : ":"),
        createAllLocationsMessage(locations));
  }

  public static MockitoAssertionError tooFewActualInvocations(
      Discrepancy discrepancy, DescribedInvocation wanted, List<Location> 
allLocations) {
    String message = createTooFewInvocationsMessage(discrepancy, wanted, 
allLocations);
    return new TooFewActualInvocations(message);
  }

  public static MockitoAssertionError tooFewActualInvocationsInOrder(
      Discrepancy discrepancy, DescribedInvocation wanted, List<Location> 
locations) {
    String message = createTooFewInvocationsMessage(discrepancy, wanted, 
locations);
    return new VerificationInOrderFailure(join("Verification in order failure:" 
+ message));
  }

  public static MockitoAssertionError noMoreInteractionsWanted(
      @Nullable Invocation undesired, List<VerificationAwareInvocation> 
invocations) {
    ScenarioPrinter scenarioPrinter = new ScenarioPrinter();
    String scenario = scenarioPrinter.print(invocations);

    if (undesired == null) {
      return new NoInteractionsWanted(
          join(
              "No interactions wanted here:",
              new LocationImpl(),
              "But found an unverified interaction.",
              scenario));
    }

    return new NoInteractionsWanted(
        join(
            "No interactions wanted here:",
            new LocationImpl(),
            "But found this interaction on mock '"
                + MockUtil.getMockName(undesired.getMock())
                + "':",
            undesired.getLocation(),
            scenario));
  }

  public static MockitoAssertionError noMoreInteractionsWantedInOrder(Invocation
undesired) {
    return new VerificationInOrderFailure(
        join(
            "No interactions wanted here:",
            new LocationImpl(),
            "But found this interaction on mock '"
                + MockUtil.getMockName(undesired.getMock())
                + "':",
            undesired.getLocation()));
  }

  public static MockitoAssertionError noInteractionsWanted(
      Object mock, List<VerificationAwareInvocation> invocations) {
    ScenarioPrinter scenarioPrinter = new ScenarioPrinter();
    String scenario = scenarioPrinter.print(invocations);

    List<Location> locations = new ArrayList<Location>();
    for (VerificationAwareInvocation invocation : invocations) {
      locations.add(invocation.getLocation());
    }

    return new NoInteractionsWanted(
        join(
            "No interactions wanted here:",
            new LocationImpl(),
            "But found these interactions on mock '"
                + MockUtil.getMockName(mock)
                + "':",
            createAllLocationsMessage(locations),
            scenario));
  }

  // ... rest of the original Reporter methods would be here ...

}
