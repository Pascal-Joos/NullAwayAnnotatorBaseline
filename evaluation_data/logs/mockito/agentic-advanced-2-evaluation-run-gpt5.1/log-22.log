      // TODO SF hacky...
      MockCreationSettings mockSettings = getMockHandler(mock).getMockSettings();
      if (mockName.isDefault() && mockSettings instanceof CreationSettings) {
        ((CreationSettings) mockSettings).setMockName(new MockNameImpl(newName));
