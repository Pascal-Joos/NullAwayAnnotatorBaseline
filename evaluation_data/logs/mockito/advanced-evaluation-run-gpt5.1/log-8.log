                      "org.mockito.internal.creation.bytebuddy.inject.MockMethodDispatcher",
                      false,
                      null));
          for (Class<?> type : types) {
            Object module = getModule.invoke(type);
            if (!modules.contains(module) && !(Boolean) canRead.invoke(module, target)) {
              modules.add(module);
