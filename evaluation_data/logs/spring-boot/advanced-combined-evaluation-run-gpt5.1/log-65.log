				builder.clientAuth(ClientAuth.REQUIRE);
			}
			else if (this.ssl.getClientAuth() == Ssl.ClientAuth.WANT) {
				builder.clientAuth(ClientAuth.OPTIONAL);
			}
		});
		return sslContextSpec;
}

