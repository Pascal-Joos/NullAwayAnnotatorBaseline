        private void log(LogLevel level, Object message, @Nullable Throwable t) 
{
                synchronized (this.lines) {
                        if (this.destination != null) {
                                logTo(this.destination, level, message, t);
                        }
                        else {
                                this.lines.add(this.destinationSupplier, level, 
message, t);
                        }
                }
