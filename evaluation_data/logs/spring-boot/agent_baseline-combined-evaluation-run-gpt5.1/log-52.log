    21  import liquibase.exception.ChangeLogParseException;
    22  
    23  import org.springframework.boot.diagnostics.AbstractFailureAnalyzer;
    24  import org.springframework.boot.diagnostics.FailureAnalysis;
    25  
    26  /**
    27   * An {@link AbstractFailureAnalyzer} that performs analysis of failures
caused by a
    28   * missing Liquibase changelog.
    29   *
    30   * @author Andy Wilkinson
    31   */
    32  class LiquibaseChangelogMissingFailureAnalyzer extends 
AbstractFailureAnalyzer<ChangeLogParseException> {
    33  
    34          private static final String MESSAGE_SUFFIX = " does not exist";
    35  
    36          @Nullable
    37          @Override
    38          protected FailureAnalysis analyze(Throwable rootFailure, 
ChangeLogParseException cause) {
    39                  String message = cause.getMessage();
    40                  if (message == null || 
!message.endsWith(MESSAGE_SUFFIX)) {
    41                          return null;
    42                  }
    43                  String changelogPath = extractChangelogPath(cause);
    44                  return new 
FailureAnalysis(getDescription(changelogPath),
    45                                  "Make sure a Liquibase changelog is 
present at the configured path.", cause);
    46          }
    47  
    48          private String extractChangelogPath(ChangeLogParseException 
cause) {
    49                  String message = cause.getMessage();
    50                  if (message == null || 
!message.endsWith(MESSAGE_SUFFIX)) {
    51                          return "";
    52                  }
    53                  return message.substring(0, message.length() - 
MESSAGE_SUFFIX.length());
    54          }
    55  
    56          private String getDescription(String changelogPath) {
    57                  return "Liquibase failed to start because no changelog 
could be found at '" + changelogPath + "'.";
    58          }
