    "version": "0.2.0",
    "configurations": [
    {
        "type": "java",
        "name": "Launch Java Program",
        "request": "launch",
        "mainClass": ""
    },
        {
            "type": "java",
            "name": "Current File",
            "request": "launch",
            "mainClass": "${file}"
        },
        {
            "type": "java",
            "name": "Main",
            "request": "launch",
            "mainClass": "builder.Main",
            "projectName": "annotator-core"
        },
        {
            "type": "java",
            "name": "Main NullRepair Eureka",
            "request": "launch",
            "mainClass": "edu.ucr.cs.riple.core.Main",
            "projectName": "annotator-core",
            "cwd": "${workspaceFolder}",
            "classPaths": [
                "$Runtime",
                "${workspaceFolder}/annotator-core/src/main/resources"
            ],
            "args": "eureka --mode advanced"
        },
        {
            "type": "java",
            "name": "Main(2)",
            "request": "launch",
            "mainClass": "methodtrack.Main",
            "projectName": "annotator-core"
        },
        {
            "type": "java",
            "name": "Main(3)",
            "request": "launch",
            "mainClass": "parametertrack.Main",
            "projectName": "annotator-core"
        }
    ]
}